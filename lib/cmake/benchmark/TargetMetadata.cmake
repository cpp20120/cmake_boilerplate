include_guard(GLOBAL)

# Internal provenance adapter, not a compilation-policy API. Unannotated native
# targets retain the historical C++ behavior. Rust imports are explicitly tagged.
function(_boilerplate_target_backend target output)
  get_target_property(_backend ${target} BOILERPLATE_BUILD_BACKEND)
  if(NOT _backend)
    set(_backend cxx)
  endif()
  if(NOT _backend MATCHES "^(cxx|rust)$")
    message(FATAL_ERROR "Target ${target}: unsupported benchmark build backend '${_backend}'")
  endif()
  set(${output} "${_backend}" PARENT_SCOPE)
endfunction()

# List-valued Rust inputs are JSON array strings inside the existing key=value
# representation. Encode semicolons so the runners' CMake lists cannot split them.
function(_boilerplate_metadata_array output values)
  set(_array "[]")
  set(_index 0)
  foreach(_value IN LISTS values)
    string(REPLACE "\\" "\\\\" _value "${_value}")
    string(REPLACE "\"" "\\\"" _value "${_value}")
    string(REPLACE "\n" "\\n" _value "${_value}")
    string(REPLACE "\r" "\\r" _value "${_value}")
    string(REPLACE "\t" "\\t" _value "${_value}")
    string(JSON _array SET "${_array}" ${_index} "\"${_value}\"")
    math(EXPR _index "${_index}+1")
  endforeach()
  string(REPLACE ";" "\\u003b" _array "${_array}")
  set(${output} "${_array}" PARENT_SCOPE)
endfunction()

# FORMAT only preserves the two existing report layouts. Both callers receive
# key=value records plus <output>_COMPILER, _PROFILE and _BACKEND header values.
function(boilerplate_collect_target_metadata target output)
  cmake_parse_arguments(PARSE_ARGV 2 ARG "" "FORMAT" "")
  if(NOT ARG_FORMAT)
    set(ARG_FORMAT harness)
  endif()
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_FORMAT MATCHES "^(harness|scenario)$")
    message(FATAL_ERROR "boilerplate_collect_target_metadata: FORMAT must be harness or scenario")
  endif()
  _boilerplate_target_backend(${target} _backend)
  if(_backend STREQUAL "cxx")
    set(_profile "${BOILERPLATE_PROFILE}")
    if(ARG_FORMAT STREQUAL "harness")
      set(_compiler "${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}")
      get_target_property(_policies ${target} BOILERPLATE_POLICIES)
      if(NOT _policies)
        set(_policies project-defaults)
      else()
        string(REPLACE ";" "," _policies "${_policies}")
      endif()
      set(_metadata "target=${target}" "policies=${_policies}" "compiler=${_compiler}"
        "generator=${CMAKE_GENERATOR}" "project=${PROJECT_NAME}")
      set(_settings CXX_STANDARD SANITIZER CFI CFI_DIAGNOSTICS WINDOWS_CFG LTO_MODE PGO_MODE ENABLE_NATIVE
        ENABLE_NO_SEMANTIC_INTERPOSITION ENABLE_GC_SECTIONS ENABLE_NO_PLT USE_LLD ENABLE_ICF FRAME_POINTERS REPRODUCIBLE HARDENING COVERAGE)
    else()
      set(_compiler "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
      set(_metadata "CMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}")
      set(_settings LTO_MODE PGO_MODE SANITIZER CFI CFI_DIAGNOSTICS WINDOWS_CFG ENABLE_NATIVE ENABLE_NO_PLT
        ENABLE_NO_SEMANTIC_INTERPOSITION ENABLE_GC_SECTIONS ENABLE_ICF USE_LLD FRAME_POINTERS REPRODUCIBLE HARDENING COVERAGE CXX_STANDARD)
    endif()
    foreach(_setting IN LISTS _settings)
      boilerplate_get_target_setting(${target} ${_setting} _value)
      list(APPEND _metadata "${_setting}=${_value}")
    endforeach()
    if(ARG_FORMAT STREQUAL "scenario" AND DEFINED BOILERPLATE_ALLOCATOR)
      list(APPEND _metadata "BOILERPLATE_ALLOCATOR=${BOILERPLATE_ALLOCATOR}")
    endif()
    list(APPEND _metadata "backend=cxx")
  else()
    get_target_property(_version ${target} BOILERPLATE_RUST_RUSTC_VERSION)
    get_target_property(_profile ${target} BOILERPLATE_RUST_PROFILE)
    if(NOT _version OR NOT _profile)
      message(FATAL_ERROR "Rust target ${target} lacks provenance; register it with boilerplate_add_rust_executable().")
    endif()
    set(_compiler "rustc-${_version}")
    set(_metadata "backend=rust" "target=${target}" "compiler=${_compiler}"
      "generator=${CMAKE_GENERATOR}" "project=${PROJECT_NAME}" "configuration=$<CONFIG>")
    foreach(_mapping IN ITEMS
        "RUSTC|rustc" "RUSTC_VERSION|rustc_version" "CARGO|cargo" "CARGO_VERSION|cargo_version"
        "HOST|rust_host" "SYSROOT|rust_sysroot" "MANIFEST|cargo_manifest" "PACKAGE|cargo_package"
        "KIND|cargo_target_kind" "CARGO_TARGET|cargo_target_name" "EDITION|rust_edition"
        "PROFILE|cargo_profile" "TARGET_TRIPLE|rust_target" "NO_DEFAULT_FEATURES|cargo_no_default_features"
        "TARGET_DIR|cargo_target_dir" "BUILD_ID|cargo_build_id" "BUILD_TARGET|cargo_build_target")
      string(REPLACE "|" ";" _mapping "${_mapping}")
      list(GET _mapping 0 _property)
      list(GET _mapping 1 _key)
      get_property(_known TARGET ${target} PROPERTY BOILERPLATE_RUST_${_property} SET)
      if(_known)
        get_target_property(_value ${target} BOILERPLATE_RUST_${_property})
        list(APPEND _metadata "${_key}=${_value}")
      endif()
    endforeach()
    foreach(_mapping IN ITEMS "OPT_LEVEL|rust_opt_level" "LTO_MODE|rust_lto_mode"
        "DEBUG_INFO|rust_debug_info" "CODEGEN_UNITS|rust_codegen_units"
        "INCREMENTAL|rust_incremental" "ENABLE_NATIVE|rust_enable_native"
        "FRAME_POINTERS|rust_frame_pointers" "SANITIZER|rust_sanitizer")
      string(REPLACE "|" ";" _mapping "${_mapping}")
      list(GET _mapping 0 _property)
      list(GET _mapping 1 _key)
      get_property(_known TARGET ${target} PROPERTY BOILERPLATE_RUST_EFFECTIVE_${_property} SET)
      if(_known)
        get_target_property(_value ${target} BOILERPLATE_RUST_EFFECTIVE_${_property})
        list(APPEND _metadata "${_key}=${_value}")
      endif()
    endforeach()
    foreach(_mapping IN ITEMS "FEATURES|cargo_features_requested" "FLAGS|rustflags_explicit")
      string(REPLACE "|" ";" _mapping "${_mapping}")
      list(GET _mapping 0 _property)
      list(GET _mapping 1 _key)
      get_property(_known TARGET ${target} PROPERTY BOILERPLATE_RUST_${_property} SET)
      if(_known)
        get_target_property(_values ${target} BOILERPLATE_RUST_${_property})
        _boilerplate_metadata_array(_value "${_values}")
        list(APPEND _metadata "${_key}=${_value}")
      endif()
    endforeach()
  endif()
  set(${output} "${_metadata}" PARENT_SCOPE)
  set(${output}_BACKEND "${_backend}" PARENT_SCOPE)
  set(${output}_COMPILER "${_compiler}" PARENT_SCOPE)
  set(${output}_PROFILE "${_profile}" PARENT_SCOPE)
endfunction()
