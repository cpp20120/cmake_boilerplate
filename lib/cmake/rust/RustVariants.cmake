include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/RustPolicies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/RustEnvironment.cmake")

# Files read by Cargo that influence compilation; Cargo owns the dependency
# graph, but these inputs also affect the identity of our external build variant.
function(_boilerplate_rust_inputs manifest metadata)
  set(_files "${manifest}")
  string(JSON _workspace GET "${metadata}" workspace_root)
  if(EXISTS "${_workspace}/Cargo.toml")
    list(APPEND _files "${_workspace}/Cargo.toml")
  endif()
  get_filename_component(_dir "${manifest}" DIRECTORY)
  while(TRUE)
    foreach(_name IN ITEMS config config.toml)
      if(EXISTS "${_dir}/.cargo/${_name}")
        list(APPEND _files "${_dir}/.cargo/${_name}")
      endif()
    endforeach()
    get_filename_component(_parent "${_dir}" DIRECTORY)
    if(_dir STREQUAL _parent)
      break()
    endif()
    set(_dir "${_parent}")
  endwhile()
  if(DEFINED ENV{CARGO_HOME})
    set(_cargo_home "$ENV{CARGO_HOME}")
  elseif(CMAKE_HOST_WIN32)
    set(_cargo_home "$ENV{USERPROFILE}/.cargo")
  else()
    set(_cargo_home "$ENV{HOME}/.cargo")
  endif()
  foreach(_name IN ITEMS config config.toml)
    if(EXISTS "${_cargo_home}/${_name}")
      list(APPEND _files "${_cargo_home}/${_name}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _files)
  list(SORT _files)
  set(_inputs)
  set(_config_flags FALSE)
  foreach(_file IN LISTS _files)
    file(SHA256 "${_file}" _hash)
    list(APPEND _inputs "${_file}|${_hash}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
    if(NOT _file MATCHES "Cargo.toml$")
      file(READ "${_file}" _contents)
      if(_contents MATCHES "rustflags[ \t]*=")
        set(_config_flags TRUE)
      endif()
      if(_contents MATCHES "(^|\n)[ \t]*include[ \t]*=")
        message(FATAL_ERROR "Cargo config include in ${_file} is not tracked by the Rust variant fingerprint")
      endif()
    endif()
  endforeach()
  _boilerplate_rust_environment(_environment _environment_fingerprints)
  set(_environment_fingerprints "${_environment_fingerprints}" PARENT_SCOPE)
  set(_input_files "${_inputs}" PARENT_SCOPE)
  set(_config_flags "${_config_flags}" PARENT_SCOPE)
  set(_environment "${_environment}" PARENT_SCOPE)
  set(_workspace "${_workspace}" PARENT_SCOPE)
endfunction()

# Inherited ARG_* are the parsed arguments of boilerplate_add_rust_executable.
# Each CMake configuration invokes this independently, so different effective
# policies never share a mutable Cargo artifact path.
function(_boilerplate_rust_variant config target)
  _boilerplate_rust_resolve_policy("${config}" "${target}")
  set(_flags)
  set(_owns_flags FALSE)
  if(DEFINED ENV{CARGO_ENCODED_RUSTFLAGS})
    string(ASCII 31 _sep)
    string(REPLACE "${_sep}" ";" _flags "$ENV{CARGO_ENCODED_RUSTFLAGS}")
    set(_owns_flags TRUE)
  elseif(DEFINED ENV{RUSTFLAGS})
    # Cargo parses RUSTFLAGS by whitespace, not shell quoting.
    string(REGEX MATCHALL "[^ \t\r\n]+" _flags "$ENV{RUSTFLAGS}")
    set(_owns_flags TRUE)
  endif()
  if(ARG_RUSTFLAGS OR _lowered_flags)
    if(NOT _owns_flags AND (_config_flags OR DEFINED ENV{CARGO_BUILD_RUSTFLAGS}))
      message(FATAL_ERROR "Rust ${target}: CMake flags would replace Cargo config rustflags. Explicitly consolidate them in the CMake RUSTFLAGS list or CARGO_ENCODED_RUSTFLAGS")
    endif()
    if(NOT _owns_flags)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE _target_env)
      if(_target_env MATCHES "CARGO_TARGET_[A-Z0-9_]+_RUSTFLAGS=")
        message(FATAL_ERROR "Rust ${target}: target-specific Cargo environment rustflags would be displaced by explicit Rust flags")
      endif()
    endif()
    set(_owns_flags TRUE)
  endif()
  list(APPEND _flags ${ARG_RUSTFLAGS})
  string(JOIN " " _raw ${_flags})
  # Explicit, conflicting -C options must not silently override profile values.
  foreach(_pair IN ITEMS "RUST_OPT_LEVEL|opt-level" "RUST_DEBUG_INFO|debuginfo" "LTO_MODE|lto"
      "RUST_CODEGEN_UNITS|codegen-units" "ENABLE_NATIVE|target-cpu" "FRAME_POINTERS|force-frame-pointers")
    string(REPLACE "|" ";" _pair "${_pair}")
    list(GET _pair 0 _key)
    list(GET _pair 1 _flag)
    if(NOT _s_${_key} STREQUAL "inherit" AND _raw MATCHES "(^|[ =])${_flag}([ =]|$)")
      message(FATAL_ERROR "Rust ${target}: conflicting raw '-C ${_flag}' and ${_key} policy")
    endif()
  endforeach()
  list(APPEND _flags ${_lowered_flags})
  # Canonical feature order: features are set-like, compiler flag order is not.
  set(_features ${ARG_FEATURES})
  if(_features)
    list(REMOVE_DUPLICATES _features)
    list(SORT _features)
  endif()
  set(_content "")
  foreach(_key IN ITEMS _manifest _workspace ARG_PACKAGE _CARGO _RUSTC _CARGO_VERSION
      _RUSTC_VERSION _SYSROOT _s_RUST_TARGET _s_RUST_CARGO_PROFILE _profile_env
      _flags _owns_flags _features ARG_NO_DEFAULT_FEATURES _input_files _environment)
    boilerplate_append_setting(_content "${_key}" "${${_key}}")
  endforeach()
  # CMake imports are separate producers even when Cargo inputs match. This
  # avoids two independent custom targets declaring the same Ninja BYPRODUCTS.
  boilerplate_append_setting(_content cmake_registration "${target}")
  boilerplate_append_setting(_content instrumentation none)
  # Runtime/tool changes in place should invalidate the variant too.
  foreach(_key IN ITEMS _CARGO _RUSTC)
    file(SHA256 "${${_key}}" _sha)
    boilerplate_append_setting(_content "${_key}_sha256" "${_sha}")
  endforeach()
  string(SHA256 _identity "${_content}")
  set(_target_dir "${CMAKE_BINARY_DIR}/cargo/${_identity}")
  set(_profile_dir "${_s_RUST_CARGO_PROFILE}")
  if(_profile_dir STREQUAL dev)
    set(_profile_dir debug)
  endif()
  foreach(_key IN ITEMS RUST_OPT_LEVEL RUST_DEBUG_INFO RUST_CODEGEN_UNITS RUST_INCREMENTAL
      RUST_CARGO_PROFILE RUST_TARGET LTO_MODE FRAME_POINTERS ENABLE_NATIVE DEBUG_SYMBOLS)
    set(_s_${_key} "${_s_${_key}}" PARENT_SCOPE)
  endforeach()
  foreach(_key IN ITEMS _identity _target_dir _profile_dir _flags _owns_flags _profile_env _features)
    set(${_key} "${${_key}}" PARENT_SCOPE)
  endforeach()
endfunction()
