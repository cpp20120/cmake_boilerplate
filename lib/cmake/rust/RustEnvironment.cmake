include_guard(GLOBAL)

# Track build-affecting environment, never registry credentials. Used during
# configure and invocation: a changed ambient build context requires reconfigure.
function(_boilerplate_rust_environment output)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE _env)
  string(REPLACE "\n" ";" _lines "${_env}")
  set(_entries)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^(RUSTFLAGS|CARGO_ENCODED_RUSTFLAGS|RUSTC_WRAPPER|RUSTC_WORKSPACE_WRAPPER|RUSTUP_TOOLCHAIN|CARGO_HOME|CARGO_INCREMENTAL|CARGO_BUILD_[A-Z0-9_]+|CARGO_PROFILE_[A-Z0-9_]+|CARGO_TARGET_[A-Z0-9_]+|CC|CXX|AR|CFLAGS|CXXFLAGS|LDFLAGS)=")
      # CARGO_TARGET_TMPDIR is set by Cargo for runtime test execution, not
      # a compiler configuration input. Do not fingerprint that transient path.
      if(_line MATCHES "^CARGO_TARGET_TMPDIR=")
        continue()
      endif()
      list(APPEND _entries "${_line}")
    endif()
  endforeach()
  list(SORT _entries)
  string(SHA256 _hash "${_entries}")
  set(${output} "${_hash}" PARENT_SCOPE)
  # Optional redacted snapshot: only names and hashes, never actual values.
  # It explains which ambient build input changed, rather than forcing the
  # developer to guess why CTest and a direct CMake invocation differ.
  if(ARGC GREATER 1)
    set(_fingerprints)
    foreach(_entry IN LISTS _entries)
      string(FIND "${_entry}" "=" _pos)
      string(SUBSTRING "${_entry}" 0 ${_pos} _name)
      string(SHA256 _digest "${_entry}")
      list(APPEND _fingerprints "${_name}=${_digest}")
    endforeach()
    set(${ARGV1} "${_fingerprints}" PARENT_SCOPE)
  endif()
endfunction()

# Shared with RunCargo and RunFuzz: normalize native launcher additions,
# but fingerprint all original compilation inputs and fail on drift.
function(_boilerplate_rust_validate_environment)
# Some build/test launchers add native compiler variables after configuration.
# The Cargo producer captured its environment when the variant was registered:
# an absent variable must remain absent during compilation, not silently alter
# cc-rs/build-script behavior or make the build fail spuriously. Preserve and
# validate values that *were* present in the producer's snapshot.
if(DEFINED RUST_ENVIRONMENT_FINGERPRINTS)
  foreach(_native_var IN ITEMS CC CXX AR CFLAGS CXXFLAGS LDFLAGS)
    set(_present_at_configure FALSE)
    foreach(_snapshot_entry IN LISTS RUST_ENVIRONMENT_FINGERPRINTS)
      if(_snapshot_entry MATCHES "^${_native_var}=")
        set(_present_at_configure TRUE)
        break()
      endif()
    endforeach()
    if(NOT _present_at_configure)
      unset(ENV{${_native_var}})
    endif()
  endforeach()
endif()
_boilerplate_rust_environment(_actual_environment _actual_fingerprints)
if(DEFINED RUST_ENVIRONMENT_HASH AND NOT _actual_environment STREQUAL RUST_ENVIRONMENT_HASH)
  set(_differences)
  foreach(_expected IN LISTS RUST_ENVIRONMENT_FINGERPRINTS)
    string(REGEX REPLACE "=.*$" "" _key "${_expected}")
    set(_match FALSE)
    foreach(_actual IN LISTS _actual_fingerprints)
      if(_actual MATCHES "^${_key}=")
        set(_match TRUE)
        if(NOT _actual STREQUAL _expected)
          list(APPEND _differences "${_key} (changed)")
        endif()
        break()
      endif()
    endforeach()
    if(NOT _match)
      list(APPEND _differences "${_key} (unset)")
    endif()
  endforeach()
  foreach(_actual IN LISTS _actual_fingerprints)
    string(REGEX REPLACE "=.*$" "" _key "${_actual}")
    set(_match FALSE)
    foreach(_expected IN LISTS RUST_ENVIRONMENT_FINGERPRINTS)
      if(_expected MATCHES "^${_key}=")
        set(_match TRUE)
        break()
      endif()
    endforeach()
    if(NOT _match)
      list(APPEND _differences "${_key} (added)")
    endif()
  endforeach()
  if(NOT DEFINED RUST_ENVIRONMENT_FINGERPRINTS)
    set(_details "No environment snapshot available (reconfigure once to capture it).")
  elseif(_differences)
    string(JOIN ", " _details ${_differences})
  else()
    set(_details "Tracked environment inputs differ, but changed keys could not be isolated")
  endif()
  message(FATAL_ERROR
    "Rust build environment changed since CMake configuration; changed keys: ${_details}. "
    "Reconfigure to refresh the Cargo build variant. Values intentionally omitted.")
endif()
endfunction()
