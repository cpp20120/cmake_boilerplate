include_guard(GLOBAL)

set(BOILERPLATE_RUST_TOOLCHAIN "" CACHE STRING "Installed rustup toolchain (exclusive with tool path overrides)")
set(BOILERPLATE_RUST_CARGO "" CACHE FILEPATH "Explicit Cargo executable; companion rustc is discovered beside it")
set(BOILERPLATE_RUST_RUSTC "" CACHE FILEPATH "Explicit rustc executable; companion Cargo is discovered beside it")

function(_boilerplate_rust_probe output)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error
    OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 30)
  if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Rust toolchain probe failed: ${ARGN}\n${_output}\n${_error}\nSelect an installed BOILERPLATE_RUST_TOOLCHAIN or matching absolute BOILERPLATE_RUST_CARGO and BOILERPLATE_RUST_RUSTC paths.")
  endif()
  set(${output} "${_output}" PARENT_SCOPE)
endfunction()

# Resolve rustup symlinks AND Windows hard-linked proxies to actual tool binaries.
function(_boilerplate_rust_resolve input name output)
  if(NOT IS_ABSOLUTE "${input}" OR NOT EXISTS "${input}")
    message(FATAL_ERROR "Rust ${name} not found: '${input}'. Install Rust or set BOILERPLATE_RUST_CARGO / BOILERPLATE_RUST_RUSTC to matching absolute paths.")
  endif()
  get_filename_component(_dir "${input}" DIRECTORY)
  set(_rustup "${_dir}/rustup${_rust_exe}")
  set(_proxy FALSE)
  if(EXISTS "${_rustup}")
    file(SHA256 "${input}" _tool_hash)
    file(SHA256 "${_rustup}" _rustup_hash)
    if(_tool_hash STREQUAL _rustup_hash)
      set(_proxy TRUE)
    endif()
  endif()
  if(_proxy)
    _boilerplate_rust_probe(_resolved "${_rustup}" which "${name}")
  else()
    set(_resolved "${input}")
  endif()
  file(REAL_PATH "${_resolved}" _resolved)
  set(${output} "${_resolved}" PARENT_SCOPE)
endfunction()

function(_boilerplate_project_rust_configure)
  if(CMAKE_CROSSCOMPILING OR CMAKE_OSX_ARCHITECTURES)
    message(FATAL_ERROR "Rust stage 1 supports native, single-architecture builds only; cross/universal builds are deferred.")
  endif()
  if(CMAKE_HOST_WIN32)
    set(_rust_exe .exe)
  else()
    set(_rust_exe "")
  endif()
  if(BOILERPLATE_RUST_TOOLCHAIN)
    if(BOILERPLATE_RUST_CARGO OR BOILERPLATE_RUST_RUSTC)
      message(FATAL_ERROR "Choose BOILERPLATE_RUST_TOOLCHAIN or explicit Rust tool paths, not both.")
    endif()
    find_program(_rustup NAMES rustup NO_CACHE NO_CMAKE_FIND_ROOT_PATH)
    if(NOT _rustup)
      message(FATAL_ERROR "BOILERPLATE_RUST_TOOLCHAIN requires rustup on PATH; install the requested toolchain first.")
    endif()
    _boilerplate_rust_probe(_cargo "${_rustup}" which --toolchain "${BOILERPLATE_RUST_TOOLCHAIN}" cargo)
    _boilerplate_rust_probe(_rustc "${_rustup}" which --toolchain "${BOILERPLATE_RUST_TOOLCHAIN}" rustc)
  else()
    set(_cargo "${BOILERPLATE_RUST_CARGO}")
    set(_rustc "${BOILERPLATE_RUST_RUSTC}")
    if(NOT _cargo AND NOT _rustc)
      unset(_cargo)
      find_program(_cargo NAMES cargo NO_CACHE NO_CMAKE_FIND_ROOT_PATH)
    endif()
    if(NOT _rustc)
      get_filename_component(_dir "${_cargo}" DIRECTORY)
      set(_rustc "${_dir}/rustc${_rust_exe}")
    elseif(NOT _cargo)
      get_filename_component(_dir "${_rustc}" DIRECTORY)
      set(_cargo "${_dir}/cargo${_rust_exe}")
    endif()
  endif()
  _boilerplate_rust_resolve("${_cargo}" cargo _cargo)
  _boilerplate_rust_resolve("${_rustc}" rustc _rustc)
  get_filename_component(_cargo_bin "${_cargo}" DIRECTORY)
  get_filename_component(_rustc_bin "${_rustc}" DIRECTORY)
  if(NOT _cargo_bin STREQUAL _rustc_bin)
    message(FATAL_ERROR "Incompatible Rust toolchain: Cargo=${_cargo}, rustc=${_rustc}. Tools must come from the same installation; do not mix /usr Rust and rustup. Set matching tool overrides or BOILERPLATE_RUST_TOOLCHAIN.")
  endif()
  _boilerplate_rust_probe(_cargo_info "${_cargo}" --version --verbose)
  _boilerplate_rust_probe(_rustc_info "${_rustc}" --version --verbose)
  _boilerplate_rust_probe(_sysroot "${_rustc}" --print sysroot)
  foreach(_tool IN ITEMS cargo rustc)
    if(NOT _${_tool}_info MATCHES "host: ([^\r\n]+)")
      message(FATAL_ERROR "Cannot detect ${_tool} host triple: ${_${_tool}_info}")
    endif()
    set(_${_tool}_host "${CMAKE_MATCH_1}")
    if(NOT _${_tool}_info MATCHES "release: ([0-9]+\\.[0-9]+\\.[0-9]+[^\r\n]*)")
      message(FATAL_ERROR "Cannot detect ${_tool} version: ${_${_tool}_info}")
    endif()
    set(_${_tool}_version "${CMAKE_MATCH_1}")
    string(REGEX MATCH "^[0-9]+\\.[0-9]+" _${_tool}_series "${_${_tool}_version}")
  endforeach()
  if(NOT _cargo_host STREQUAL _rustc_host OR NOT _cargo_series STREQUAL _rustc_series)
    message(FATAL_ERROR "Incompatible Rust toolchain: cargo ${_cargo_version} (${_cargo_host}), rustc ${_rustc_version} (${_rustc_host}). Select tools from the same Rust release and host.")
  endif()
  if(_rustc_version VERSION_LESS 1.74)
    message(FATAL_ERROR "Rust integration requires Rust/Cargo 1.74 or newer; found ${_rustc_version}.")
  endif()
  if(NOT IS_DIRECTORY "${_sysroot}/lib/rustlib/${_rustc_host}")
    message(FATAL_ERROR "Incomplete Rust sysroot '${_sysroot}': standard library for ${_rustc_host} is missing. Repair/install this toolchain.")
  endif()
  foreach(_pair IN ITEMS "CARGO;${_cargo}" "RUSTC;${_rustc}" "CARGO_VERSION;${_cargo_version}"
      "RUSTC_VERSION;${_rustc_version}" "SYSROOT;${_sysroot}" "HOST;${_rustc_host}" "BIN;${_rustc_bin}" "EXE_SUFFIX;${_rust_exe}")
    list(GET _pair 0 _key)
    list(GET _pair 1 _value)
    set_property(GLOBAL PROPERTY BOILERPLATE_RUST_${_key} "${_value}")
  endforeach()
  message(STATUS "Boilerplate Rust: Cargo ${_cargo_version}: ${_cargo}; rustc ${_rustc_version}: ${_rustc}; host=${_rustc_host}; sysroot=${_sysroot}")
endfunction()
