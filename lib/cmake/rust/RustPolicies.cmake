include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/RustProfiles.cmake")

function(_boilerplate_rust_resolve_policy config target)
  # These project-level modes have no Rust lowering until Stage 3. Explicitly
  # reject them rather than producing an apparently sanitized/PGO build.
  if(BOILERPLATE_PGO_MODE AND NOT BOILERPLATE_PGO_MODE STREQUAL "none")
    message(FATAL_ERROR "Rust target ${target}: BOILERPLATE_PGO_MODE=${BOILERPLATE_PGO_MODE} is unsupported until Rust PGO is implemented")
  endif()
  if(BOILERPLATE_SANITIZER AND NOT BOILERPLATE_SANITIZER STREQUAL "none")
    message(FATAL_ERROR "Rust target ${target}: BOILERPLATE_SANITIZER=${BOILERPLATE_SANITIZER} is unsupported until Rust sanitizer integration")
  endif()
  set(_supported LTO_MODE ENABLE_NATIVE FRAME_POINTERS DEBUG_SYMBOLS
    RUST_OPT_LEVEL RUST_DEBUG_INFO RUST_CODEGEN_UNITS RUST_INCREMENTAL
    RUST_CARGO_PROFILE RUST_TARGET)
  foreach(_key IN LISTS _supported)
    string(REGEX REPLACE "^RUST_" "" _short "${_key}")
    set(_s_${_key} "${BOILERPLATE_RUST_${_short}}")
  endforeach()
  # Orthogonal project defaults are common where semantics actually match.
  # Do not translate their neutral C++ OFF/none values into explicit Cargo
  # overrides, because that would erase profiles specified by Cargo.toml.
  if(_s_LTO_MODE STREQUAL "inherit" AND
      BOILERPLATE_PROFILE STREQUAL "custom" AND
      BOILERPLATE_LTO_MODE MATCHES "^(thin|full)$")
    set(_s_LTO_MODE "${BOILERPLATE_LTO_MODE}")
  endif()
  if(_s_ENABLE_NATIVE STREQUAL "inherit" AND BOILERPLATE_ENABLE_NATIVE)
    set(_s_ENABLE_NATIVE true)
  endif()
  if(_s_FRAME_POINTERS STREQUAL "inherit" AND BOILERPLATE_FRAME_POINTERS)
    set(_s_FRAME_POINTERS true)
  endif()
  if(_s_DEBUG_SYMBOLS STREQUAL "inherit" AND BOILERPLATE_DEBUG_SYMBOLS)
    set(_s_DEBUG_SYMBOLS true)
  endif()
  set(_selected_profile "${BOILERPLATE_PROFILE}")
  if(ARG_PROFILE)
    set(_selected_profile "${ARG_PROFILE}")
  endif()
  _boilerplate_rust_named_profile("${_selected_profile}" "${config}")
  # Named profile values do not erase explicit Rust defaults.
  if(_named_opt AND _s_RUST_OPT_LEVEL STREQUAL "inherit")
    set(_s_RUST_OPT_LEVEL "${_named_opt}")
  endif()
  if(_named_debug AND _s_RUST_DEBUG_INFO STREQUAL "inherit")
    set(_s_RUST_DEBUG_INFO "${_named_debug}")
  endif()
  if(_named_lto AND _s_LTO_MODE STREQUAL "inherit")
    set(_s_LTO_MODE "${_named_lto}")
  endif()
  if(_named_native AND _s_ENABLE_NATIVE STREQUAL "inherit")
    set(_s_ENABLE_NATIVE "${_named_native}")
  endif()

  get_property(_keys GLOBAL PROPERTY BOILERPLATE_POLICY_KEYS)
  foreach(_policy IN LISTS ARG_POLICIES)
    _boilerplate_policy_id("${_policy}" _id)
    get_property(_defined GLOBAL PROPERTY "BOILERPLATE_POLICY_${_id}_DEFINED")
    if(NOT _defined)
      message(FATAL_ERROR "Unknown Rust target policy '${_policy}' for ${target}")
    endif()
    get_property(_hooks GLOBAL PROPERTY "BOILERPLATE_POLICY_${_id}_HOOKS")
    if(_hooks)
      message(FATAL_ERROR "Rust policy '${_policy}' contains C++ compiler hooks")
    endif()
    foreach(_key IN LISTS _keys)
      get_property(_set GLOBAL PROPERTY "BOILERPLATE_POLICY_${_id}_${_key}" SET)
      if(_set)
        if(NOT _key IN_LIST _supported)
          message(FATAL_ERROR "Rust policy '${_policy}' contains unsupported C++ setting ${_key}")
        endif()
        get_property(_s_${_key} GLOBAL PROPERTY "BOILERPLATE_POLICY_${_id}_${_key}")
      endif()
    endforeach()
  endforeach()
  foreach(_key IN LISTS _keys)
    if(DEFINED ARG_${_key})
      if(NOT _key IN_LIST _supported)
        message(FATAL_ERROR "Rust target ${target}: unsupported policy option ${_key}")
      endif()
      set(_s_${_key} "${ARG_${_key}}")
    endif()
  endforeach()

  foreach(_key IN ITEMS ENABLE_NATIVE FRAME_POINTERS DEBUG_SYMBOLS RUST_INCREMENTAL)
    string(TOLOWER "${_s_${_key}}" _value)
    if(_value MATCHES "^(on|true|yes|1)$")
      set(_s_${_key} true)
    elseif(_value MATCHES "^(off|false|no|0)$")
      set(_s_${_key} false)
    elseif(_value STREQUAL "inherit")
      set(_s_${_key} inherit)
    else()
      message(FATAL_ERROR "Rust ${_key} must be ON/OFF/inherit; got '${_s_${_key}}'")
    endif()
  endforeach()
  if(NOT _s_DEBUG_SYMBOLS STREQUAL "inherit")
    if(_s_DEBUG_SYMBOLS STREQUAL "true")
      set(_s_RUST_DEBUG_INFO 2)
    else()
      set(_s_RUST_DEBUG_INFO 0)
    endif()
    # Explicit Rust debug-info value is more specific than convenience option.
    if(DEFINED ARG_RUST_DEBUG_INFO)
      set(_s_RUST_DEBUG_INFO "${ARG_RUST_DEBUG_INFO}")
    endif()
  endif()
  if(NOT _s_RUST_OPT_LEVEL MATCHES "^(inherit|0|1|2|3|s|z)$" OR
      NOT _s_RUST_DEBUG_INFO MATCHES "^(inherit|0|1|2|line-tables-only|line-directives-only)$" OR
      NOT _s_LTO_MODE MATCHES "^(inherit|none|off|thin|full|fat)$" OR
      NOT _s_RUST_CODEGEN_UNITS MATCHES "^(inherit|[1-9][0-9]*)$")
    message(FATAL_ERROR "Rust ${target}: invalid optimization/debug/LTO/codegen policy")
  endif()
  if(_s_LTO_MODE MATCHES "^(none|off)$")
    set(_s_LTO_MODE off)
  elseif(_s_LTO_MODE MATCHES "^(full|fat)$")
    set(_s_LTO_MODE fat)
  endif()
  if(_s_RUST_CARGO_PROFILE STREQUAL "inherit")
    set(_s_RUST_CARGO_PROFILE "${_named_profile}")
  endif()
  if(NOT _s_RUST_CARGO_PROFILE MATCHES "^[a-z][a-z0-9_-]*$" OR
      _s_RUST_CARGO_PROFILE MATCHES "^(test|bench|debug|build-override)$")
    message(FATAL_ERROR "Rust Cargo profile '${_s_RUST_CARGO_PROFILE}' is invalid/reserved")
  endif()
  if(_s_RUST_TARGET STREQUAL "inherit")
    set(_s_RUST_TARGET "${_HOST}")
  endif()
  if(NOT _s_RUST_TARGET MATCHES "^[A-Za-z0-9_]+(-[A-Za-z0-9_]+)+$")
    message(FATAL_ERROR "Rust target triple '${_s_RUST_TARGET}' is invalid (custom target JSON is deferred)")
  endif()
  # Cross-target support is deliberately absent from Stage 1 toolchain discovery.
  if(NOT _s_RUST_TARGET STREQUAL _HOST OR CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Rust cross compilation is not implemented; expected host triple ${_HOST}")
  endif()
  set(_lowered_flags)
  if(_s_ENABLE_NATIVE STREQUAL true)
    list(APPEND _lowered_flags -C target-cpu=native)
  elseif(_s_ENABLE_NATIVE STREQUAL false)
    list(APPEND _lowered_flags -C target-cpu=generic)
  endif()
  if(_s_FRAME_POINTERS STREQUAL true)
    list(APPEND _lowered_flags -C force-frame-pointers=yes)
  elseif(_s_FRAME_POINTERS STREQUAL false)
    list(APPEND _lowered_flags -C force-frame-pointers=no)
  endif()
  string(TOUPPER "${_s_RUST_CARGO_PROFILE}" _profile_key)
  string(REPLACE "-" "_" _profile_key "${_profile_key}")
  set(_profile_env)
  foreach(_pair IN ITEMS "RUST_OPT_LEVEL|OPT_LEVEL" "LTO_MODE|LTO" "RUST_DEBUG_INFO|DEBUG"
      "RUST_CODEGEN_UNITS|CODEGEN_UNITS" "RUST_INCREMENTAL|INCREMENTAL")
    string(REPLACE "|" ";" _pair "${_pair}")
    list(GET _pair 0 _key)
    list(GET _pair 1 _cargo_key)
    if(NOT _s_${_key} STREQUAL "inherit")
      list(APPEND _profile_env "CARGO_PROFILE_${_profile_key}_${_cargo_key}=${_s_${_key}}")
    endif()
  endforeach()
  foreach(_key IN LISTS _supported)
    set(_s_${_key} "${_s_${_key}}" PARENT_SCOPE)
  endforeach()
  set(_profile_env "${_profile_env}" PARENT_SCOPE)
  set(_lowered_flags "${_lowered_flags}" PARENT_SCOPE)
endfunction()
