include_guard(GLOBAL)

# Only explicit Rust defaults override Cargo's own manifest/config profiles.
# 'inherit' differs from deliberately requesting OFF/0/none.
foreach(_key IN ITEMS OPT_LEVEL DEBUG_INFO CODEGEN_UNITS INCREMENTAL CARGO_PROFILE TARGET
    LTO_MODE FRAME_POINTERS ENABLE_NATIVE DEBUG_SYMBOLS SANITIZER)
  set(BOILERPLATE_RUST_${_key} inherit CACHE STRING
    "Rust ${_key}; inherit leaves Cargo's own setting unchanged")
endforeach()

# Resolve a boilerplate preset independently of the C++ driver/driver validation.
# The caller provides the selected CMake configuration.
function(_boilerplate_rust_named_profile name config)
  if(NOT config MATCHES "^(Debug|Release|RelWithDebInfo)$")
    message(FATAL_ERROR "Unsupported Rust CMake configuration '${config}'")
  endif()
  if(name STREQUAL "custom")
    if(config STREQUAL "Debug")
      set(_named_profile dev)
    else()
      set(_named_profile release)
    endif()
    if(config STREQUAL "RelWithDebInfo")
      set(_named_opt 3)
      set(_named_debug 2)
    endif()
  else()
    if(NOT name MATCHES "^(debug|release|relwithdebinfo|lto|full-lto|native-thinlto|native-full-lto|o3|o3-lto)$")
      message(FATAL_ERROR "Rust profile '${name}' is unsupported (Rust PGO/sanitizers deferred)")
    endif()
    set(_named_profile release)
    if(name STREQUAL "debug")
      set(_named_profile dev)
    elseif(name STREQUAL "relwithdebinfo")
      set(_named_opt 3)
      set(_named_debug 2)
    endif()
    if(name MATCHES "^(lto|native-thinlto)$")
      set(_named_lto thin)
    elseif(name MATCHES "^(full-lto|native-full-lto|o3-lto)$")
      set(_named_lto fat)
    endif()
    if(name MATCHES "^native-")
      set(_named_native true)
    endif()
    if(name MATCHES "^o3")
      set(_named_opt 3)
    endif()
  endif()
  foreach(_key IN ITEMS profile opt debug lto native)
    set(_named_${_key} "${_named_${_key}}" PARENT_SCOPE)
  endforeach()
endfunction()
