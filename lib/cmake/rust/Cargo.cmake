include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Toolchain.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/RustVariants.cmake")

function(_boilerplate_rust_require)
  boilerplate_project_has_capability(rust _enabled)
  if(NOT _enabled)
    message(FATAL_ERROR "Rust API requires boilerplate_project(CAPABILITIES rust ...). C++-only projects need no Rust tools.")
  endif()
  get_property(_frozen GLOBAL PROPERTY BOILERPLATE_PROJECT_GRAPH_FROZEN)
  if(_frozen)
    message(FATAL_ERROR "Register Rust targets/tests before boilerplate_finalize_project().")
  endif()
endfunction()

function(boilerplate_add_rust_executable target)
  _boilerplate_rust_require()
  cmake_parse_arguments(PARSE_ARGV 1 ARG "EXCLUDE_FROM_ALL;NO_DEFAULT_FEATURES;LOCKED;OFFLINE"
    "MANIFEST;KIND;CARGO_TARGET;PACKAGE;PROFILE" "FEATURES;RUSTFLAGS;DEPENDS;POLICIES;POLICY_OPTIONS")
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_MANIFEST)
    message(FATAL_ERROR "boilerplate_add_rust_executable(${target}): MANIFEST is required; unsupported arguments: ${ARG_UNPARSED_ARGUMENTS};${ARG_KEYWORDS_MISSING_VALUES}. C++ policies are not Rust options.")
  endif()
  if(NOT target MATCHES "^[A-Za-z][A-Za-z0-9_.+-]*$")
    message(FATAL_ERROR "Rust CMake target must be a filesystem-safe identifier: ${target}")
  endif()
  if(NOT ARG_KIND)
    set(ARG_KIND bin)
  endif()
  if(NOT ARG_KIND MATCHES "^(bin|example)$")
    message(FATAL_ERROR "Rust KIND must be bin or example, got '${ARG_KIND}'.")
  endif()
  if(NOT ARG_CARGO_TARGET)
    set(ARG_CARGO_TARGET "${target}")
  endif()
  if(NOT ARG_CARGO_TARGET MATCHES "^[A-Za-z0-9_-]+$")
    message(FATAL_ERROR "Invalid Cargo executable name: ${ARG_CARGO_TARGET}")
  endif()
  get_filename_component(_manifest "${ARG_MANIFEST}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  if(NOT EXISTS "${_manifest}")
    message(FATAL_ERROR "Cargo manifest does not exist: ${_manifest}")
  endif()
  get_filename_component(_workdir "${_manifest}" DIRECTORY)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest}")
  get_property(_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if(_multi)
    set(_configs "${CMAKE_CONFIGURATION_TYPES}")
  else()
    set(_configs "${CMAKE_BUILD_TYPE}")
  endif()
  if(NOT _configs)
    message(FATAL_ERROR "Rust requires an explicit Debug or Release configuration; set CMAKE_BUILD_TYPE.")
  endif()
  foreach(_config IN LISTS _configs)
    if(NOT _config MATCHES "^(Debug|Release|RelWithDebInfo)$")
      message(FATAL_ERROR "Rust configuration '${_config}' must be Debug/Release/RelWithDebInfo")
    endif()
  endforeach()

  foreach(_key IN ITEMS CARGO RUSTC CARGO_VERSION RUSTC_VERSION SYSROOT HOST BIN EXE_SUFFIX)
    get_property(_${_key} GLOBAL PROPERTY BOILERPLATE_RUST_${_key})
  endforeach()
  # Validate the import against Cargo's own manifest interpretation, including
  # example crate types (an example can also be a library, which we cannot import).
  execute_process(COMMAND "${_CARGO}" metadata --no-deps --format-version 1 --manifest-path "${_manifest}"
    WORKING_DIRECTORY "${_workdir}" RESULT_VARIABLE _result
    OUTPUT_VARIABLE _metadata ERROR_VARIABLE _error TIMEOUT 30)
  if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Cargo could not read ${_manifest}: ${_error}")
  endif()
  string(JSON _count LENGTH "${_metadata}" packages)
  set(_matches 0)
  if(_count GREATER 0)
    math(EXPR _last "${_count}-1")
    foreach(_index RANGE ${_last})
      string(JSON _package GET "${_metadata}" packages ${_index})
      string(JSON _package_name GET "${_package}" name)
      string(JSON _package_manifest GET "${_package}" manifest_path)
      if(ARG_PACKAGE AND NOT ARG_PACKAGE STREQUAL _package_name)
        continue()
      endif()
      string(JSON _target_count LENGTH "${_package}" targets)
      math(EXPR _target_last "${_target_count}-1")
      foreach(_index_target RANGE ${_target_last})
        string(JSON _name GET "${_package}" targets ${_index_target} name)
        string(JSON _kind GET "${_package}" targets ${_index_target} kind 0)
        string(JSON _crate_type GET "${_package}" targets ${_index_target} crate_types 0)
        if(_name STREQUAL ARG_CARGO_TARGET AND _kind STREQUAL ARG_KIND AND _crate_type STREQUAL "bin")
          math(EXPR _matches "${_matches}+1")
          set(_selected_package "${_package_name}")
          string(JSON _edition GET "${_package}" targets ${_index_target} edition)
          string(JSON _minimum ERROR_VARIABLE _missing GET "${_package}" rust_version)
          if(_minimum AND _RUSTC_VERSION VERSION_LESS _minimum)
            message(FATAL_ERROR "Cargo package ${_package_name} requires Rust ${_minimum}; selected rustc is ${_RUSTC_VERSION}. Select a newer BOILERPLATE_RUST_TOOLCHAIN or matching tool overrides.")
          endif()
        endif()
      endforeach()
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_package_manifest}")
    endforeach()
  endif()
  if(NOT _matches EQUAL 1)
    message(FATAL_ERROR "Expected one executable ${ARG_KIND} '${ARG_CARGO_TARGET}' in ${_manifest}, found ${_matches}. Check KIND/CARGO_TARGET and use PACKAGE to select a workspace member.")
  endif()
  set(ARG_PACKAGE "${_selected_package}")
  # POLICY_OPTIONS is a list of KEY VALUE pairs, not shell flags.
  if(ARG_POLICY_OPTIONS)
    list(LENGTH ARG_POLICY_OPTIONS _count_options)
    math(EXPR _odd "${_count_options}%2")
    if(_odd)
      message(FATAL_ERROR "Rust POLICY_OPTIONS must consist of KEY VALUE pairs")
    endif()
    get_property(_policy_keys GLOBAL PROPERTY BOILERPLATE_POLICY_KEYS)
    while(ARG_POLICY_OPTIONS)
      list(POP_FRONT ARG_POLICY_OPTIONS _key _value)
      if(NOT _key IN_LIST _policy_keys)
        message(FATAL_ERROR "Rust target ${target}: unknown policy key '${_key}'")
      endif()
      set(ARG_${_key} "${_value}")
    endwhile()
  endif()
  _boilerplate_rust_inputs("${_manifest}" "${_metadata}")
  # Each selected CMake configuration is resolved and lowered independently.
  # The imported executable exposes one location for each configuration.
  set(_base "${CMAKE_CURRENT_BINARY_DIR}/rust/${target}")
  set(_filename "${ARG_CARGO_TARGET}${_EXE_SUFFIX}")
  if(ARG_KIND STREQUAL "example")
    set(_filename "examples/${_filename}")
  endif()
  set(_runner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunCargo.cmake")
  set(_profile_genex "")
  set(_dir_genex "")
  set(_id_genex "")
  set(_artifact_genex "")
  foreach(_config IN LISTS _configs)
    _boilerplate_rust_variant("${_config}" "${target}")
    set(_artifact "${_target_dir}/${_s_RUST_TARGET}/${_profile_dir}/${_filename}")
    set(_config_file "${_base}/${_config}/cargo.cmake")
    set(_args --manifest-path "${_manifest}" --target "${_s_RUST_TARGET}"
      --target-dir "${_target_dir}" --profile "${_s_RUST_CARGO_PROFILE}")
    if(ARG_PACKAGE)
      list(APPEND _args --package "${ARG_PACKAGE}")
    endif()
    if(_features)
      list(JOIN _features , _features_arg)
      list(APPEND _args --features "${_features_arg}")
    endif()
    foreach(_option IN ITEMS NO_DEFAULT_FEATURES LOCKED OFFLINE)
      if(ARG_${_option})
        string(TOLOWER "${_option}" _option_arg)
        string(REPLACE _ - _option_arg "${_option_arg}")
        list(APPEND _args "--${_option_arg}")
      endif()
    endforeach()
    set(_content "")
    foreach(_key IN ITEMS CARGO RUSTC BIN EXE_SUFFIX)
      boilerplate_append_setting(_content RUST_${_key} "${_${_key}}")
    endforeach()
    boilerplate_append_setting(_content RUST_MANIFEST "${_manifest}")
    boilerplate_append_setting(_content RUST_PACKAGE "${ARG_PACKAGE}")
    boilerplate_append_setting(_content RUST_WORKING_DIRECTORY "${_workdir}")
    boilerplate_append_setting(_content RUST_TARGET_DIR "${_target_dir}")
    boilerplate_append_setting(_content RUST_ARGS "${_args}")
    boilerplate_append_setting(_content RUST_FLAGS "${_flags}")
    boilerplate_append_setting(_content RUST_OWNS_FLAGS "${_owns_flags}")
    boilerplate_append_setting(_content RUST_PROFILE_ENV "${_profile_env}")
    boilerplate_append_setting(_content RUST_ENVIRONMENT_HASH "${_environment}")
    boilerplate_append_setting(_content RUST_KIND "${ARG_KIND}")
    boilerplate_append_setting(_content RUST_CARGO_TARGET "${ARG_CARGO_TARGET}")
    file(GENERATE OUTPUT "${_config_file}" CONTENT "${_content}"
      CONDITION "$<CONFIG:${_config}>")
    string(TOUPPER "${_config}" _upper)
    set(_content_${_upper} "${_content}")
    set(_artifact_${_upper} "${_artifact}")
    set(_profile_${_upper} "${_s_RUST_CARGO_PROFILE}")
    set(_dir_${_upper} "${_target_dir}")
    set(_id_${_upper} "${_identity}")
    foreach(_pair IN ITEMS
        "OPT_LEVEL|${_s_RUST_OPT_LEVEL}" "LTO_MODE|${_s_LTO_MODE}"
        "DEBUG_INFO|${_s_RUST_DEBUG_INFO}" "CODEGEN_UNITS|${_s_RUST_CODEGEN_UNITS}"
        "INCREMENTAL|${_s_RUST_INCREMENTAL}" "ENABLE_NATIVE|${_s_ENABLE_NATIVE}"
        "FRAME_POINTERS|${_s_FRAME_POINTERS}")
      string(REPLACE "|" ";" _pair "${_pair}")
      list(GET _pair 0 _key)
      list(GET _pair 1 _value)
      set(_resolved_${_upper}_${_key} "${_value}")
    endforeach()
  endforeach()
  # Generate config-dependent expressions without depending on CMake's binary
  # output conventions for imported Cargo programs.
  foreach(_key IN ITEMS artifact profile dir id)
    set(_expr "")
    foreach(_config IN LISTS _configs)
      string(TOUPPER "${_config}" _upper)
      if(_expr STREQUAL "")
        set(_expr "${_${_key}_${_upper}}")
      else()
        set(_expr "$<IF:$<CONFIG:${_config}>,${_${_key}_${_upper}},${_expr}>")
      endif()
    endforeach()
    set(_${_key}_genex "${_expr}")
  endforeach()
  set(_all ALL)
  if(ARG_EXCLUDE_FROM_ALL)
    set(_all)
  endif()
  add_custom_target(${target}_cargo ${_all}
    COMMAND "${CMAKE_COMMAND}" "-DRUST_CONFIG=${_base}/$<CONFIG>/cargo.cmake" -DRUST_MODE=build -P "${_runner}"
    BYPRODUCTS "${_artifact_genex}" DEPENDS ${ARG_DEPENDS} USES_TERMINAL VERBATIM)
  add_executable(${target} IMPORTED GLOBAL)
  set_property(TARGET ${target} PROPERTY IMPORTED_CONFIGURATIONS "${_configs}")
  foreach(_config IN LISTS _configs)
    string(TOUPPER "${_config}" _upper)
    set_property(TARGET ${target} PROPERTY IMPORTED_LOCATION_${_upper} "${_artifact_${_upper}}")
    set_property(TARGET ${target} PROPERTY BOILERPLATE_RUST_CONFIG_CONTENT_${_upper} "${_content_${_upper}}")
  endforeach()
  add_dependencies(${target} ${target}_cargo)
  set_target_properties(${target} PROPERTIES
    BOILERPLATE_BUILD_BACKEND rust
    BOILERPLATE_RUST_EDITION "${_edition}"
    BOILERPLATE_RUST_PROFILE "${_profile_genex}"
    BOILERPLATE_RUST_TARGET_TRIPLE "${_HOST}"
    BOILERPLATE_RUST_BUILD_ID "${_id_genex}"
    BOILERPLATE_RUST_MANIFEST "${_manifest}" BOILERPLATE_RUST_PACKAGE "${ARG_PACKAGE}"
    BOILERPLATE_RUST_KIND "${ARG_KIND}" BOILERPLATE_RUST_CARGO_TARGET "${ARG_CARGO_TARGET}"
    BOILERPLATE_RUST_FEATURES "${ARG_FEATURES}" BOILERPLATE_RUST_FLAGS "${ARG_RUSTFLAGS}"
    BOILERPLATE_RUST_NO_DEFAULT_FEATURES "${ARG_NO_DEFAULT_FEATURES}"
    BOILERPLATE_RUST_TARGET_DIR "${_dir_genex}"
    BOILERPLATE_RUST_CONFIG "${_base}/$<CONFIG>/cargo.cmake"
    BOILERPLATE_RUST_BUILD_TARGET "${target}_cargo")
  foreach(_key IN ITEMS CARGO RUSTC CARGO_VERSION RUSTC_VERSION SYSROOT HOST)
    set_property(TARGET ${target} PROPERTY BOILERPLATE_RUST_${_key} "${_${_key}}")
  endforeach()
  foreach(_key IN ITEMS OPT_LEVEL LTO_MODE DEBUG_INFO CODEGEN_UNITS INCREMENTAL ENABLE_NATIVE FRAME_POINTERS)
    set(_expr "")
    foreach(_config IN LISTS _configs)
      string(TOUPPER "${_config}" _upper)
      if(_expr STREQUAL "")
        set(_expr "${_resolved_${_upper}_${_key}}")
      else()
        set(_expr "$<IF:$<CONFIG:${_config}>,${_resolved_${_upper}_${_key}},${_expr}>")
      endif()
    endforeach()
    set_property(TARGET ${target} PROPERTY BOILERPLATE_RUST_EFFECTIVE_${_key} "${_expr}")
  endforeach()
  boilerplate_set_artifact_role(${target} EXECUTABLE)
  set_property(TARGET ${target}_cargo PROPERTY FOLDER "boilerplate/rust")
  foreach(_quality IN ITEMS format format-check clippy)
    if(NOT TARGET rust-${_quality})
      add_custom_target(rust-${_quality})
      set_property(TARGET rust-${_quality} PROPERTY FOLDER "boilerplate/quality")
    endif()
    add_custom_target(${target}_${_quality}
      COMMAND "${CMAKE_COMMAND}" "-DRUST_CONFIG=${_config_file}" "-DRUST_MODE=${_quality}" -P "${_runner}"
      DEPENDS ${ARG_DEPENDS} USES_TERMINAL VERBATIM)
    add_dependencies(rust-${_quality} ${target}_${_quality})
    set_property(TARGET ${target}_${_quality} PROPERTY FOLDER "boilerplate/quality")
  endforeach()
endfunction()

# One CTest entry for the selected package's Cargo --all-targets suite. Reuse
# the registration's complete build context, rather than accepting divergent flags.
function(boilerplate_add_rust_test name)
  _boilerplate_rust_require()
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "TARGET;TIMEOUT" "LABELS;TEST_ARGS")
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT TARGET "${ARG_TARGET}")
    message(FATAL_ERROR "boilerplate_add_rust_test(${name}): TARGET must name a Rust executable; invalid arguments: ${ARG_UNPARSED_ARGUMENTS};${ARG_KEYWORDS_MISSING_VALUES}")
  endif()
  get_target_property(_config_path ${ARG_TARGET} BOILERPLATE_RUST_CONFIG)
  if(NOT _config_path)
    message(FATAL_ERROR "${ARG_TARGET} was not registered with boilerplate_add_rust_executable().")
  endif()
  boilerplate_project_has_capability(testing _testing)
  if(NOT _testing)
    message(FATAL_ERROR "Rust tests require the existing testing project capability.")
  endif()
  if(NOT BUILD_TESTING)
    return()
  endif()
  if(NOT name MATCHES "^[A-Za-z][A-Za-z0-9_.+-]*$")
    message(FATAL_ERROR "Invalid Rust test name: ${name}")
  endif()
  if(NOT ARG_TIMEOUT)
    set(ARG_TIMEOUT 120)
  endif()
  if(NOT ARG_TIMEOUT MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Rust test TIMEOUT must be a positive integer: ${ARG_TIMEOUT}")
  endif()
  set(_config "${CMAKE_CURRENT_BINARY_DIR}/rust-tests/$<CONFIG>/${name}.cmake")
  get_target_property(_configs ${ARG_TARGET} IMPORTED_CONFIGURATIONS)
  foreach(_cmake_config IN LISTS _configs)
    string(TOUPPER "${_cmake_config}" _upper)
    get_target_property(_content ${ARG_TARGET} BOILERPLATE_RUST_CONFIG_CONTENT_${_upper})
    boilerplate_append_setting(_content RUST_TEST_ARGS "${ARG_TEST_ARGS}")
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/rust-tests/${_cmake_config}/${name}.cmake"
      CONTENT "${_content}" CONDITION "$<CONFIG:${_cmake_config}>")
  endforeach()
  set(_runner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunCargo.cmake")
  add_custom_target(${name}_cargo_tests
    COMMAND "${CMAKE_COMMAND}" "-DRUST_CONFIG=${_config}" -DRUST_MODE=test-build -P "${_runner}"
    DEPENDS ${ARG_TARGET} USES_TERMINAL VERBATIM)
  add_test(NAME ${name} COMMAND "${CMAKE_COMMAND}" "-DRUST_CONFIG=${_config}" -DRUST_MODE=test -P "${_runner}")
  set_tests_properties(${name} PROPERTIES TIMEOUT "${ARG_TIMEOUT}" LABELS "rust;${ARG_LABELS}")
  _boilerplate_project_testing_finalize()
  add_dependencies(boilerplate_tests ${name}_cargo_tests)
  set_property(TARGET ${name}_cargo_tests PROPERTY FOLDER "boilerplate/tests")
endfunction()
