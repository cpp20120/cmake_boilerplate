cmake_minimum_required(VERSION 3.26)
if(NOT FUZZ_CONFIG_FILE OR NOT EXISTS "${FUZZ_CONFIG_FILE}")
  message(FATAL_ERROR "Rust fuzz config is missing: ${FUZZ_CONFIG_FILE}")
endif()
include("${FUZZ_CONFIG_FILE}")
include("${CMAKE_CURRENT_LIST_DIR}/RustEnvironment.cmake")
# Reuse the same fingerprint discipline as the Cargo build runner.
set(RUST_ENVIRONMENT_HASH "${FUZZ_ENVIRONMENT_HASH}")
set(RUST_ENVIRONMENT_FINGERPRINTS "${FUZZ_ENVIRONMENT_FINGERPRINTS}")
_boilerplate_rust_validate_environment()
set(ENV{CARGO} "${FUZZ_CARGO}")
set(ENV{RUSTC} "${FUZZ_RUSTC}")
set(ENV{RUSTDOC} "${FUZZ_BIN}/rustdoc")
set(ENV{CARGO_TARGET_DIR} "${FUZZ_TARGET_DIR}")
set(ENV{CARGO_BUILD_BUILD_DIR} "${FUZZ_TARGET_DIR}")
get_filename_component(_fuzz_binary_dir "${FUZZ_CARGO_FUZZ}" DIRECTORY)
# cargo-fuzz invokes an unqualified `cargo` subprocess. Put the selected
# toolchain first, otherwise a system cargo beside cargo-fuzz can take priority
# over the nightly Cargo selected at CMake configure time.
set(ENV{PATH} "${FUZZ_BIN}:${_fuzz_binary_dir}:$ENV{PATH}")
if(FUZZ_CONFIG STREQUAL "RelWithDebInfo")
  set(ENV{CARGO_PROFILE_RELEASE_DEBUG} 2)
endif()
set(_opts "--fuzz-dir=${FUZZ_DIR}" "--target-dir=${FUZZ_TARGET_DIR}"
  "--target=${FUZZ_TARGET_TRIPLE}" --build-std "--sanitizer=${FUZZ_SANITIZER}")
if(FUZZ_CONFIG STREQUAL "Debug")
  list(APPEND _opts --dev)
endif()
if(FUZZ_FEATURES)
  list(APPEND _opts "--features=${FUZZ_FEATURES}")
endif()
if(FUZZ_NO_DEFAULT_FEATURES)
  list(APPEND _opts --no-default-features)
endif()
if(NOT FUZZ_MODE MATCHES "^(build|run|smoke|replay)$")
  message(FATAL_ERROR "Invalid Rust fuzz mode '${FUZZ_MODE}'")
endif()
if(FUZZ_MODE STREQUAL build)
  set(_command "${FUZZ_CARGO}" fuzz build ${_opts} "${FUZZ_TARGET}")
else()
  file(MAKE_DIRECTORY "${FUZZ_CORPUS}" "${FUZZ_ARTIFACTS}")
  # Seed input is immutable; copy missing files to an owned, persistent corpus.
  if(FUZZ_SEEDS)
    file(GLOB _seeds LIST_DIRECTORIES false "${FUZZ_SEEDS}/*")
    foreach(_seed IN LISTS _seeds)
      get_filename_component(_file "${_seed}" NAME)
      if(NOT EXISTS "${FUZZ_CORPUS}/${_file}")
        file(COPY_FILE "${_seed}" "${FUZZ_CORPUS}/${_file}")
      endif()
    endforeach()
  endif()
  set(_command "${FUZZ_CARGO}" fuzz run ${_opts} "${FUZZ_TARGET}")
  if(FUZZ_MODE STREQUAL replay)
    if(NOT DEFINED ENV{BOILERPLATE_FUZZ_REPLAY_INPUT} OR "$ENV{BOILERPLATE_FUZZ_REPLAY_INPUT}" STREQUAL "")
      message(FATAL_ERROR "Rust fuzz replay requires BOILERPLATE_FUZZ_REPLAY_INPUT=/absolute/path/to/crash-file")
    endif()
    set(_input "$ENV{BOILERPLATE_FUZZ_REPLAY_INPUT}")
    if(NOT IS_ABSOLUTE "${_input}" OR NOT EXISTS "${_input}" OR IS_DIRECTORY "${_input}")
      message(FATAL_ERROR "Rust fuzz replay input must be an existing absolute file: ${_input}")
    endif()
    list(APPEND _command "${_input}" -- "-timeout=${FUZZ_TIMEOUT}")
  else()
    list(APPEND _command "${FUZZ_CORPUS}" --
      "-timeout=${FUZZ_TIMEOUT}" "-artifact_prefix=${FUZZ_ARTIFACTS}/")
    if(FUZZ_MAX_LEN)
      list(APPEND _command "-max_len=${FUZZ_MAX_LEN}")
    endif()
    if(FUZZ_DICT)
      list(APPEND _command "-dict=${FUZZ_DICT}")
    endif()
    if(FUZZ_MODE STREQUAL smoke)
      list(APPEND _command -runs=1 "-max_total_time=5")
    else()
      list(APPEND _command "-max_total_time=${FUZZ_RUN_SECONDS}")
    endif()
  endif()
endif()
execute_process(COMMAND ${_command} WORKING_DIRECTORY "${FUZZ_DIR}"
  RESULT_VARIABLE _status)
if(NOT _status STREQUAL "0")
  message(FATAL_ERROR "Rust cargo-fuzz ${FUZZ_MODE} failed (${_status}); target=${FUZZ_TARGET}; artifacts=${FUZZ_ARTIFACTS}")
endif()
