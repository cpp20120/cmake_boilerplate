include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/RustVariants.cmake")

# cargo-fuzz owns libFuzzer instrumentation and builds. CMake owns execution,
# persistence of corpora and crash artifacts, gating, and bounded smoke tests.
set(BOILERPLATE_RUST_CARGO_FUZZ "" CACHE FILEPATH
  "Optional absolute path to cargo-fuzz (normally discovered on PATH or in CARGO_HOME/bin)")

function(boilerplate_add_rust_fuzzer name)
  _boilerplate_rust_require()
  cmake_parse_arguments(PARSE_ARGV 1 ARG "NO_DEFAULT_FEATURES;NO_SMOKE"
    "MANIFEST;FUZZ_TARGET;CORPUS;SEED_CORPUS;DICTIONARY;RUN_SECONDS;TIMEOUT;MAX_LEN;SANITIZER"
    "FEATURES;LABELS;DEPENDS")
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_MANIFEST OR NOT ARG_FUZZ_TARGET)
    message(FATAL_ERROR "boilerplate_add_rust_fuzzer(${name}): MANIFEST and FUZZ_TARGET required; invalid: ${ARG_UNPARSED_ARGUMENTS};${ARG_KEYWORDS_MISSING_VALUES}")
  endif()
  if(NOT name MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR NOT ARG_FUZZ_TARGET MATCHES "^[A-Za-z0-9_-]+$")
    message(FATAL_ERROR "Rust fuzzer registration name or fuzz target is invalid")
  endif()
  get_filename_component(_manifest "${ARG_MANIFEST}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  if(NOT EXISTS "${_manifest}")
    message(FATAL_ERROR "Rust fuzz Cargo manifest is missing: ${_manifest}")
  endif()
  get_filename_component(_fuzz_dir "${_manifest}" DIRECTORY)
  if(NOT EXISTS "${_fuzz_dir}/fuzz_targets/${ARG_FUZZ_TARGET}.rs")
    message(FATAL_ERROR "Rust fuzz target missing: ${_fuzz_dir}/fuzz_targets/${ARG_FUZZ_TARGET}.rs")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_manifest}" "${_fuzz_dir}/fuzz_targets/${ARG_FUZZ_TARGET}.rs")
  if(EXISTS "${_fuzz_dir}/Cargo.lock")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_fuzz_dir}/Cargo.lock")
  endif()
  foreach(_key IN ITEMS CARGO RUSTC RUSTC_VERSION CARGO_VERSION SYSROOT HOST BIN EXE_SUFFIX)
    get_property(_${_key} GLOBAL PROPERTY BOILERPLATE_RUST_${_key})
  endforeach()
  if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT _HOST STREQUAL "x86_64-unknown-linux-gnu")
    message(FATAL_ERROR "Rust cargo-fuzz integration currently supports Linux x86_64-unknown-linux-gnu only")
  endif()
  if(NOT _RUSTC_VERSION MATCHES "-(nightly|dev)" OR NOT _CARGO_VERSION MATCHES "-(nightly|dev)")
    message(FATAL_ERROR "Rust cargo-fuzz requires a matching nightly rustc/Cargo toolchain (BOILERPLATE_RUST_TOOLCHAIN=nightly)")
  endif()
  if(NOT EXISTS "${_SYSROOT}/lib/rustlib/src/rust/library/Cargo.toml")
    message(FATAL_ERROR "Rust cargo-fuzz requires rust-src for --build-std; install rustup component add rust-src --toolchain nightly")
  endif()
  if(BOILERPLATE_RUST_CARGO_FUZZ)
    set(_cargo_fuzz "${BOILERPLATE_RUST_CARGO_FUZZ}")
  else()
    find_program(_cargo_fuzz NAMES cargo-fuzz NO_CACHE NO_CMAKE_FIND_ROOT_PATH
      HINTS "$ENV{CARGO_HOME}/bin" "$ENV{HOME}/.cargo/bin")
  endif()
  if(NOT _cargo_fuzz OR NOT EXISTS "${_cargo_fuzz}")
    message(FATAL_ERROR "Rust cargo-fuzz not found; install with 'cargo install cargo-fuzz --locked' and make it available on PATH, or set BOILERPLATE_RUST_CARGO_FUZZ")
  endif()
  if(NOT IS_ABSOLUTE "${_cargo_fuzz}")
    message(FATAL_ERROR "Rust cargo-fuzz must be an absolute executable path")
  endif()
  execute_process(COMMAND "${_cargo_fuzz}" --version RESULT_VARIABLE _version_status
    OUTPUT_VARIABLE _version_output ERROR_VARIABLE _version_error TIMEOUT 15)
  if(NOT _version_status STREQUAL "0")
    message(FATAL_ERROR "Rust cargo-fuzz could not be probed: ${_cargo_fuzz}: ${_version_error}")
  endif()
  string(STRIP "${_version_output}" _version_output)
  # cargo-fuzz links LLVM libFuzzer and requires a native C++ compiler.
  find_program(_cxx NAMES clang++ c++ g++ NO_CACHE NO_CMAKE_FIND_ROOT_PATH)
  if(NOT _cxx)
    message(FATAL_ERROR "Rust cargo-fuzz requires a native C++ compiler (clang++, c++ or g++)")
  endif()
  if(NOT ARG_SANITIZER)
    set(ARG_SANITIZER address)
  endif()
  if(NOT ARG_SANITIZER MATCHES "^(address|none)$")
    message(FATAL_ERROR "Rust cargo-fuzz currently supports SANITIZER address or none only")
  endif()
  if(NOT ARG_RUN_SECONDS)
    set(ARG_RUN_SECONDS 60)
  endif()
  if(NOT ARG_TIMEOUT)
    set(ARG_TIMEOUT 15)
  endif()
  foreach(_key IN ITEMS RUN_SECONDS TIMEOUT MAX_LEN)
    if(ARG_${_key} AND NOT ARG_${_key} MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "Rust cargo-fuzz ${_key} must be a positive integer")
    endif()
  endforeach()
  if(ARG_CORPUS AND ARG_SEED_CORPUS)
    message(FATAL_ERROR "Rust cargo-fuzz: CORPUS and SEED_CORPUS are mutually exclusive")
  endif()
  if(ARG_SEED_CORPUS)
    get_filename_component(_seed "${ARG_SEED_CORPUS}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT IS_DIRECTORY "${_seed}")
      message(FATAL_ERROR "Rust cargo-fuzz SEED_CORPUS directory missing: ${_seed}")
    endif()
  else()
    set(_seed "")
  endif()
  if(ARG_DICTIONARY)
    get_filename_component(_dict "${ARG_DICTIONARY}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT EXISTS "${_dict}" OR IS_DIRECTORY "${_dict}")
      message(FATAL_ERROR "Rust cargo-fuzz dictionary file missing: ${_dict}")
    endif()
  else()
    set(_dict "")
  endif()
  if(ARG_CORPUS)
    get_filename_component(_corpus "${ARG_CORPUS}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  else()
    set(_corpus "${CMAKE_CURRENT_BINARY_DIR}/rust-fuzz/${name}/corpus")
  endif()
  if(_seed AND _seed STREQUAL _corpus)
    message(FATAL_ERROR "Rust cargo-fuzz: seed corpus must not equal mutable corpus")
  endif()
  set(_artifacts "${CMAKE_CURRENT_BINARY_DIR}/rust-fuzz/${name}/artifacts")
  set(_features ${ARG_FEATURES})
  if(_features)
    list(REMOVE_DUPLICATES _features)
    list(SORT _features)
    list(JOIN _features , _features_arg)
  endif()
  get_property(_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if(_multi)
    set(_configs "${CMAKE_CONFIGURATION_TYPES}")
  else()
    set(_configs "${CMAKE_BUILD_TYPE}")
  endif()
  if(NOT _configs)
    message(FATAL_ERROR "Rust fuzzing requires CMAKE_BUILD_TYPE Debug/Release/RelWithDebInfo")
  endif()
  foreach(_cfg IN LISTS _configs)
    if(NOT _cfg MATCHES "^(Debug|Release|RelWithDebInfo)$")
      message(FATAL_ERROR "Rust fuzz configuration unsupported: ${_cfg}")
    endif()
  endforeach()
  # This is deliberately not an executable/import: cargo-fuzz owns its output
  # naming, sanitizer coverage, and libFuzzer runtime. Never fake TARGET_FILE.
  _boilerplate_rust_environment(_env_hash _env_fingerprints)
  if(DEFINED ENV{RUSTFLAGS} OR DEFINED ENV{CARGO_ENCODED_RUSTFLAGS})
    message(FATAL_ERROR "Rust cargo-fuzz: ambient RUSTFLAGS/CARGO_ENCODED_RUSTFLAGS need an explicit fuzz-compatible build; unset before CMake configure")
  endif()
  file(SHA256 "${_cargo_fuzz}" _fuzz_sha)
  file(SHA256 "${_CARGO}" _cargo_sha)
  file(SHA256 "${_RUSTC}" _rustc_sha)
  file(SHA256 "${_manifest}" _manifest_sha)
  if(EXISTS "${_fuzz_dir}/Cargo.lock")
    file(SHA256 "${_fuzz_dir}/Cargo.lock" _lock_sha)
  else()
    set(_lock_sha "absent")
  endif()
  set(_config "${CMAKE_CURRENT_BINARY_DIR}/rust-fuzz/${name}/$<CONFIG>/fuzz.cmake")
  foreach(_cfg IN LISTS _configs)
    set(_identity_content "${_manifest}|${_manifest_sha}|${_lock_sha}|${_cargo_sha}|${_rustc_sha}|${_fuzz_sha}|${_HOST}|${_env_hash}|${ARG_FUZZ_TARGET}|${name}|${_cfg}|${_features}|${ARG_NO_DEFAULT_FEATURES}|${ARG_SANITIZER}")
    string(SHA256 _identity "${_identity_content}")
    set(_target_dir "${CMAKE_BINARY_DIR}/cargo-fuzz/${_identity}")
    set(_content "")
    boilerplate_append_setting(_content FUZZ_CARGO "${_CARGO}")
    boilerplate_append_setting(_content FUZZ_RUSTC "${_RUSTC}")
    boilerplate_append_setting(_content FUZZ_CARGO_FUZZ "${_cargo_fuzz}")
    boilerplate_append_setting(_content FUZZ_BIN "${_BIN}")
    boilerplate_append_setting(_content FUZZ_MANIFEST "${_manifest}")
    boilerplate_append_setting(_content FUZZ_DIR "${_fuzz_dir}")
    boilerplate_append_setting(_content FUZZ_TARGET "${ARG_FUZZ_TARGET}")
    boilerplate_append_setting(_content FUZZ_TARGET_TRIPLE "${_HOST}")
    boilerplate_append_setting(_content FUZZ_TARGET_DIR "${_target_dir}")
    boilerplate_append_setting(_content FUZZ_CORPUS "${_corpus}")
    boilerplate_append_setting(_content FUZZ_SEEDS "${_seed}")
    boilerplate_append_setting(_content FUZZ_ARTIFACTS "${_artifacts}")
    boilerplate_append_setting(_content FUZZ_DICT "${_dict}")
    boilerplate_append_setting(_content FUZZ_FEATURES "${_features_arg}")
    boilerplate_append_setting(_content FUZZ_NO_DEFAULT_FEATURES "${ARG_NO_DEFAULT_FEATURES}")
    boilerplate_append_setting(_content FUZZ_SANITIZER "${ARG_SANITIZER}")
    boilerplate_append_setting(_content FUZZ_RUN_SECONDS "${ARG_RUN_SECONDS}")
    boilerplate_append_setting(_content FUZZ_TIMEOUT "${ARG_TIMEOUT}")
    boilerplate_append_setting(_content FUZZ_MAX_LEN "${ARG_MAX_LEN}")
    boilerplate_append_setting(_content FUZZ_ENVIRONMENT_HASH "${_env_hash}")
    boilerplate_append_setting(_content FUZZ_ENVIRONMENT_FINGERPRINTS "${_env_fingerprints}")
    boilerplate_append_setting(_content FUZZ_CONFIG "${_cfg}")
    boilerplate_append_setting(_content FUZZ_BUILD_ID "${_identity}")
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/rust-fuzz/${name}/${_cfg}/fuzz.cmake"
      CONTENT "${_content}" CONDITION "$<CONFIG:${_cfg}>")
  endforeach()
  set(_runner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunFuzz.cmake")
  add_custom_target(${name}_cargo_fuzz_build
    COMMAND "${CMAKE_COMMAND}" "-DFUZZ_CONFIG_FILE=${_config}" -DFUZZ_MODE=build -P "${_runner}"
    DEPENDS ${ARG_DEPENDS} USES_TERMINAL VERBATIM)
  add_custom_target(fuzz_${name}
    COMMAND "${CMAKE_COMMAND}" "-DFUZZ_CONFIG_FILE=${_config}" -DFUZZ_MODE=run -P "${_runner}"
    DEPENDS ${name}_cargo_fuzz_build USES_TERMINAL VERBATIM)
  add_custom_target(replay_${name}
    COMMAND "${CMAKE_COMMAND}" "-DFUZZ_CONFIG_FILE=${_config}" -DFUZZ_MODE=replay -P "${_runner}"
    DEPENDS ${name}_cargo_fuzz_build USES_TERMINAL VERBATIM)
  set_property(TARGET ${name}_cargo_fuzz_build PROPERTY FOLDER "boilerplate/fuzz")
  set_property(TARGET fuzz_${name} PROPERTY FOLDER "boilerplate/fuzz")
  set_property(TARGET replay_${name} PROPERTY FOLDER "boilerplate/fuzz")
  # Reuse the existing aggregate when the project enables the fuzzing
  # capability; Rust-only projects need no C++ language enabled.
  set_property(GLOBAL APPEND PROPERTY BOILERPLATE_FUZZ_TARGETS "${name}_cargo_fuzz_build")
  set_property(GLOBAL APPEND PROPERTY BOILERPLATE_FUZZ_RUN_TARGETS "fuzz_${name}")
  if(NOT ARG_NO_SMOKE)
    boilerplate_project_has_capability(testing _testing)
    if(NOT _testing)
      message(FATAL_ERROR "Rust fuzzer ${name}: smoke tests require project testing capability; or use NO_SMOKE")
    endif()
    if(BUILD_TESTING)
      add_test(NAME ${name}_smoke COMMAND "${CMAKE_COMMAND}"
        "-DFUZZ_CONFIG_FILE=${_config}" -DFUZZ_MODE=smoke -P "${_runner}")
      math(EXPR _ctest_timeout "${ARG_TIMEOUT}+90")
      set_tests_properties(${name}_smoke PROPERTIES TIMEOUT "${_ctest_timeout}"
        LABELS "rust;fuzz;smoke;libfuzzer;${ARG_LABELS}")
      _boilerplate_project_testing_finalize()
      add_dependencies(boilerplate_tests ${name}_cargo_fuzz_build)
      set_property(GLOBAL APPEND PROPERTY BOILERPLATE_FUZZ_SMOKE_TESTS "${name}_smoke")
    endif()
  endif()
endfunction()
