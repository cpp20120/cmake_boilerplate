cmake_minimum_required(VERSION 3.26)
if(NOT RUST_CONFIG OR NOT EXISTS "${RUST_CONFIG}")
  message(FATAL_ERROR "Rust invocation config is missing: ${RUST_CONFIG}")
endif()
include("${RUST_CONFIG}")
include("${CMAKE_CURRENT_LIST_DIR}/RustEnvironment.cmake")
_boilerplate_rust_validate_environment()
foreach(_entry IN LISTS RUST_PROFILE_ENV)
  string(FIND "${_entry}" "=" _position)
  if(_position LESS 1)
    message(FATAL_ERROR "Malformed Cargo profile environment entry: ${_entry}")
  endif()
  string(SUBSTRING "${_entry}" 0 ${_position} _name)
  math(EXPR _start "${_position}+1")
  string(SUBSTRING "${_entry}" ${_start} -1 _value)
  set(ENV{${_name}} "${_value}")
endforeach()
set(ENV{CARGO} "${RUST_CARGO}")
set(ENV{RUSTC} "${RUST_RUSTC}")
set(ENV{RUSTDOC} "${RUST_BIN}/rustdoc${RUST_EXE_SUFFIX}")
set(ENV{RUSTC_WRAPPER} "")
set(ENV{RUSTC_WORKSPACE_WRAPPER} "")
if(RUST_OWNS_FLAGS)
  string(ASCII 31 _separator)
  list(JOIN RUST_FLAGS "${_separator}" _flags)
  set(ENV{CARGO_ENCODED_RUSTFLAGS} "${_flags}")
  unset(ENV{RUSTFLAGS})
endif()
set(ENV{CARGO_TARGET_DIR} "${RUST_TARGET_DIR}")
# Newer Cargo can put intermediate artifacts elsewhere; keep them in the tree too.
set(ENV{CARGO_BUILD_BUILD_DIR} "${RUST_TARGET_DIR}")
if(CMAKE_HOST_WIN32)
  set(ENV{PATH} "${RUST_BIN};$ENV{PATH}")
else()
  set(ENV{PATH} "${RUST_BIN}:$ENV{PATH}")
endif()
set(_command "${RUST_CARGO}")
if(RUST_MODE MATCHES "^format(-check)?$")
  foreach(_tool IN ITEMS cargo-fmt rustfmt)
    if(NOT EXISTS "${RUST_BIN}/${_tool}${RUST_EXE_SUFFIX}")
      message(FATAL_ERROR "Rust formatting needs ${_tool} beside ${RUST_CARGO}. Install rustfmt for the selected toolchain (rustup component add rustfmt --toolchain <selected-toolchain>, or your system package manager).")
    endif()
  endforeach()
  set(ENV{RUSTFMT} "${RUST_BIN}/rustfmt${RUST_EXE_SUFFIX}")
  set(_command "${RUST_BIN}/cargo-fmt${RUST_EXE_SUFFIX}" fmt --manifest-path "${RUST_MANIFEST}")
  if(RUST_PACKAGE)
    list(APPEND _command --package "${RUST_PACKAGE}")
  endif()
  if(RUST_MODE STREQUAL "format-check")
    list(APPEND _command -- --check)
  endif()
elseif(RUST_MODE STREQUAL "clippy")
  foreach(_tool IN ITEMS cargo-clippy clippy-driver)
    if(NOT EXISTS "${RUST_BIN}/${_tool}${RUST_EXE_SUFFIX}")
      message(FATAL_ERROR "Rust Clippy needs ${_tool} beside ${RUST_CARGO}. Install clippy for the selected toolchain (rustup component add clippy --toolchain <selected-toolchain>, or your system package manager).")
    endif()
  endforeach()
  set(_command "${RUST_BIN}/cargo-clippy${RUST_EXE_SUFFIX}" clippy ${RUST_ARGS} --all-targets -- -D warnings)
elseif(RUST_MODE STREQUAL "build")
  list(APPEND _command build ${RUST_ARGS} "--${RUST_KIND}" "${RUST_CARGO_TARGET}")
elseif(RUST_MODE MATCHES "^test(-build)?$")
  list(APPEND _command test ${RUST_ARGS} --all-targets)
  if(RUST_MODE STREQUAL "test-build")
    list(APPEND _command --no-run)
  elseif(RUST_TEST_ARGS)
    list(APPEND _command -- ${RUST_TEST_ARGS})
  endif()
else()
  message(FATAL_ERROR "Unknown Rust operation: ${RUST_MODE}")
endif()
execute_process(COMMAND ${_command} WORKING_DIRECTORY "${RUST_WORKING_DIRECTORY}" RESULT_VARIABLE _result)
if(NOT _result STREQUAL "0")
  message(FATAL_ERROR "Cargo ${RUST_MODE} failed (${_result}); selected toolchain: ${RUST_CARGO}, ${RUST_RUSTC}")
endif()
