include_guard(GLOBAL)

# CTest writes coverage tool paths into DartConfiguration.tcl when included.
# Call this before include(CTest) for the opt-in LLVM source backend.
function(boilerplate_dashboard_prepare_llvm_coverage)
  if(BOILERPLATE_DASHBOARD_COVERAGE AND
      BOILERPLATE_DASHBOARD_COVERAGE_BACKEND STREQUAL "llvm-cov")
    find_program(_merge NAMES llvm-profdata REQUIRED)
    find_program(_data NAMES llvm-cov REQUIRED)
    set(CTEST_TEST_COVERAGE_TOOL LLVM-COV PARENT_SCOPE)
    set(CTEST_TEST_COVERAGE_MERGE_EXECUTABLE "${_merge}" PARENT_SCOPE)
    set(CTEST_TEST_COVERAGE_DATA_EXECUTABLE "${_data}" PARENT_SCOPE)
  endif()
endfunction()

function(_boilerplate_project_dashboard_configure)
  if(NOT PROJECT_IS_TOP_LEVEL)
    message(FATAL_ERROR "dashboard capability requires a top-level project")
  endif()
  if(NOT BUILD_TESTING)
    message(FATAL_ERROR "dashboard capability requires BUILD_TESTING=ON")
  endif()
  option(BOILERPLATE_DASHBOARD_SUBMIT "Submit dashboard XML to CDash" OFF)
  option(BOILERPLATE_DASHBOARD_COVERAGE "Collect CTest Coverage.xml after tests" OFF)
  option(BOILERPLATE_DASHBOARD_MEMCHECK "Run a separate CTest MemCheck stage" OFF)
  option(BOILERPLATE_DASHBOARD_SUBMIT_FAILURE_FATAL "Fail when CDash submission fails" ON)
  set(BOILERPLATE_DASHBOARD_URL "" CACHE STRING "CDash submission URL (without credentials)")
  set(BOILERPLATE_DASHBOARD_PROJECT "${PROJECT_NAME}" CACHE STRING "CDash project name")
  set(BOILERPLATE_DASHBOARD_SITE "" CACHE STRING "Dashboard site override")
  set(BOILERPLATE_DASHBOARD_BUILD_NAME "" CACHE STRING "Dashboard build name override")
  set(BOILERPLATE_DASHBOARD_MODEL Experimental CACHE STRING "CTest dashboard model")
  set_property(CACHE BOILERPLATE_DASHBOARD_MODEL PROPERTY STRINGS Experimental Nightly Continuous)
  set(BOILERPLATE_DASHBOARD_CONFIGURATION "" CACHE STRING "Build configuration override")
  set(BOILERPLATE_DASHBOARD_VARIANT "local" CACHE STRING "CI/build variant name")
  set(BOILERPLATE_DASHBOARD_LABEL "" CACHE STRING "Optional CTest label regex")
  set(BOILERPLATE_DASHBOARD_PARALLEL 2 CACHE STRING "CTest/build parallelism")
  set(BOILERPLATE_DASHBOARD_TEST_TIMEOUT 300 CACHE STRING "Default test timeout in seconds")
  set(BOILERPLATE_DASHBOARD_TEST_LOAD "" CACHE STRING "Optional CTest load limit")
  set(BOILERPLATE_DASHBOARD_RESOURCE_SPEC "" CACHE FILEPATH "Optional CTest resource specification")
  set(BOILERPLATE_DASHBOARD_RETRY_COUNT 0 CACHE STRING "CDash timed-out submission retries")
  set(BOILERPLATE_DASHBOARD_RETRY_DELAY 5 CACHE STRING "Seconds between CDash retries")
  set(BOILERPLATE_DASHBOARD_COVERAGE_BACKEND gcov CACHE STRING "Coverage backend: gcov or llvm-cov")
  set_property(CACHE BOILERPLATE_DASHBOARD_COVERAGE_BACKEND PROPERTY STRINGS gcov llvm-cov)
  set(BOILERPLATE_DASHBOARD_MEMCHECK_COMMAND "" CACHE FILEPATH "Optional memory checker executable; defaults to valgrind")

  if(NOT BOILERPLATE_DASHBOARD_MODEL MATCHES "^(Experimental|Nightly|Continuous)$")
    message(FATAL_ERROR "Invalid BOILERPLATE_DASHBOARD_MODEL")
  endif()
  foreach(_number IN ITEMS PARALLEL TEST_TIMEOUT)
    if(NOT BOILERPLATE_DASHBOARD_${_number} MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "BOILERPLATE_DASHBOARD_${_number} must be positive")
    endif()
  endforeach()
  foreach(_number IN ITEMS RETRY_COUNT RETRY_DELAY)
    if(NOT BOILERPLATE_DASHBOARD_${_number} MATCHES "^[0-9]+$")
      message(FATAL_ERROR "BOILERPLATE_DASHBOARD_${_number} must be nonnegative")
    endif()
  endforeach()
  if(BOILERPLATE_DASHBOARD_SUBMIT)
    if(NOT BOILERPLATE_DASHBOARD_URL MATCHES "^https?://[^/]+/.+" OR
       BOILERPLATE_DASHBOARD_URL MATCHES "^https?://[^/]*@" OR
       BOILERPLATE_DASHBOARD_PROJECT STREQUAL "")
      message(FATAL_ERROR "Dashboard submission requires BOILERPLATE_DASHBOARD_URL (HTTP(S), no credentials) and BOILERPLATE_DASHBOARD_PROJECT")
    endif()
  endif()
  if(BOILERPLATE_DASHBOARD_COVERAGE)
    if(BOILERPLATE_DASHBOARD_COVERAGE_BACKEND STREQUAL "gcov")
      if(NOT BOILERPLATE_COVERAGE)
        message(FATAL_ERROR "Dashboard gcov coverage requires BOILERPLATE_COVERAGE=ON")
      endif()
      if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        find_program(_dashboard_gcov gcov REQUIRED)
        set(_dashboard_gcov_flags "")
      elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        if(BOILERPLATE_COVERAGE_GCOV_TOOL)
          set(_gcov_tool ${BOILERPLATE_COVERAGE_GCOV_TOOL})
        else()
          get_filename_component(_compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
          string(REGEX MATCH "^[0-9]+" _major "${CMAKE_CXX_COMPILER_VERSION}")
          find_program(_dashboard_gcov NAMES "llvm-cov-${_major}" llvm-cov
            HINTS "${_compiler_dir}")
          # Apple's /usr/bin/clang and /usr/bin/g++ are Xcode shims. llvm-cov
          # can live inside the selected Xcode toolchain, outside PATH.
          if(NOT _dashboard_gcov AND APPLE)
            find_program(_dashboard_xcrun NAMES xcrun)
            if(_dashboard_xcrun)
              execute_process(COMMAND "${_dashboard_xcrun}" --find llvm-cov
                RESULT_VARIABLE _xcrun_status OUTPUT_VARIABLE _xcrun_cov
                ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
              if(_xcrun_status EQUAL 0 AND EXISTS "${_xcrun_cov}" AND
                  NOT IS_DIRECTORY "${_xcrun_cov}")
                set(_dashboard_gcov "${_xcrun_cov}")
              endif()
            endif()
          endif()
          if(NOT _dashboard_gcov)
            message(FATAL_ERROR
              "Dashboard Clang coverage requires a compatible llvm-cov. "
              "Install it or set BOILERPLATE_COVERAGE_GCOV_TOOL to '<llvm-cov>;gcov'.")
          endif()
          set(_gcov_tool "${_dashboard_gcov}" gcov)
        endif()
        list(GET _gcov_tool 0 _dashboard_gcov)
        list(REMOVE_AT _gcov_tool 0)
        string(JOIN " " _dashboard_gcov_flags ${_gcov_tool})
      else()
        message(FATAL_ERROR "Dashboard gcov coverage requires GCC or Clang")
      endif()
    elseif(BOILERPLATE_DASHBOARD_COVERAGE_BACKEND STREQUAL "llvm-cov")
      if(CMAKE_VERSION VERSION_LESS 4.4 OR NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR
          NOT BOILERPLATE_LLVM_SOURCE_COVERAGE OR BOILERPLATE_COVERAGE)
        message(FATAL_ERROR "Dashboard llvm-cov requires CMake 4.4+, Clang, BOILERPLATE_LLVM_SOURCE_COVERAGE=ON and BOILERPLATE_COVERAGE=OFF")
      endif()
      find_program(_dashboard_gcov NAMES llvm-cov REQUIRED)
      find_program(_dashboard_profdata NAMES llvm-profdata REQUIRED)
      set(_dashboard_gcov_flags "")
    else()
      message(FATAL_ERROR "Unknown BOILERPLATE_DASHBOARD_COVERAGE_BACKEND")
    endif()
  endif()
  if(BOILERPLATE_DASHBOARD_MEMCHECK)
    if(BOILERPLATE_SANITIZER AND NOT BOILERPLATE_SANITIZER STREQUAL "none")
      message(FATAL_ERROR "Dashboard MemCheck cannot be combined with sanitizer instrumentation")
    endif()
    if(BOILERPLATE_DASHBOARD_MEMCHECK_COMMAND)
      if(NOT EXISTS "${BOILERPLATE_DASHBOARD_MEMCHECK_COMMAND}")
        message(FATAL_ERROR "Dashboard memory checker not found: ${BOILERPLATE_DASHBOARD_MEMCHECK_COMMAND}")
      endif()
      set(_dashboard_memcheck "${BOILERPLATE_DASHBOARD_MEMCHECK_COMMAND}")
    else()
      find_program(_dashboard_memcheck valgrind)
      if(NOT _dashboard_memcheck)
        message(FATAL_ERROR "Dashboard MemCheck requires valgrind or BOILERPLATE_DASHBOARD_MEMCHECK_COMMAND")
      endif()
    endif()
  endif()

  if(BOILERPLATE_DASHBOARD_CONFIGURATION)
    set(_dashboard_config "${BOILERPLATE_DASHBOARD_CONFIGURATION}")
  elseif(CMAKE_BUILD_TYPE)
    set(_dashboard_config "${CMAKE_BUILD_TYPE}")
  else()
    set(_dashboard_config Debug)
  endif()
  if(CMAKE_CONFIGURATION_TYPES)
    if(NOT _dashboard_config IN_LIST CMAKE_CONFIGURATION_TYPES)
      message(FATAL_ERROR "Dashboard configuration '${_dashboard_config}' is not in CMAKE_CONFIGURATION_TYPES")
    endif()
  elseif(CMAKE_BUILD_TYPE AND NOT _dashboard_config STREQUAL CMAKE_BUILD_TYPE)
    message(FATAL_ERROR "Dashboard configuration '${_dashboard_config}' differs from single-config CMAKE_BUILD_TYPE='${CMAKE_BUILD_TYPE}'")
  endif()
  if(BOILERPLATE_DASHBOARD_SITE)
    set(_dashboard_site "${BOILERPLATE_DASHBOARD_SITE}")
  else()
    cmake_host_system_information(RESULT _dashboard_site QUERY HOSTNAME)
  endif()
  if(BOILERPLATE_DASHBOARD_BUILD_NAME)
    set(_dashboard_build_name "${BOILERPLATE_DASHBOARD_BUILD_NAME}")
  else()
    set(_dashboard_build_name "${CMAKE_HOST_SYSTEM_NAME}-${CMAKE_HOST_SYSTEM_PROCESSOR}-${CMAKE_CXX_COMPILER_ID}${CMAKE_CXX_COMPILER_VERSION}-${_dashboard_config}-${BOILERPLATE_DASHBOARD_VARIANT}")
  endif()
  set(_dashboard_source "${CMAKE_SOURCE_DIR}")
  set(_dashboard_binary "${CMAKE_BINARY_DIR}")
  set(_dashboard_generator "${CMAKE_GENERATOR}")
  set(_dashboard_project "${BOILERPLATE_DASHBOARD_PROJECT}")
  set(_dashboard_script "${CMAKE_BINARY_DIR}/boilerplate-dashboard.cmake")
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CTestDashboard.cmake.in"
    "${_dashboard_script}" @ONLY)
  set_property(GLOBAL PROPERTY BOILERPLATE_DASHBOARD_SCRIPT "${_dashboard_script}")
endfunction()

function(_boilerplate_project_dashboard_finalize)
  get_property(_script GLOBAL PROPERTY BOILERPLATE_DASHBOARD_SCRIPT)
  add_custom_target(boilerplate_dashboard
    COMMAND "${CMAKE_CTEST_COMMAND}" -S "${_script}" --output-on-failure
    USES_TERMINAL VERBATIM)
  if(NOT TARGET dashboard)
    add_custom_target(dashboard DEPENDS boilerplate_dashboard)
  endif()
  set_property(TARGET boilerplate_dashboard dashboard PROPERTY FOLDER "boilerplate/tests")
endfunction()
