cmake_minimum_required(VERSION 3.26)
if(NOT CHECK_BINARY)
  message(FATAL_ERROR "Pass -DCHECK_BINARY=<temporary build directory>")
endif()
if(NOT CHECK_GENERATOR)
  set(CHECK_GENERATOR Ninja)
endif()
get_filename_component(_toolkit "${CMAKE_CURRENT_LIST_DIR}/../../cmake" ABSOLUTE)
set(_source "${CHECK_BINARY}/source with spaces")
set(_build "${CHECK_BINARY}/build with spaces")
file(REMOVE_RECURSE "${_source}" "${_build}")
file(MAKE_DIRECTORY "${_source}")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/rust/" DESTINATION "${_source}"
  PATTERN out EXCLUDE PATTERN target EXCLUDE)
function(run)
  set(_command)
  math(EXPR _last "${ARGC}-1")
  foreach(_i RANGE ${_last})
    string(REPLACE ";" "\\;" _argument "${ARGV${_i}}")
    list(APPEND _command "${_argument}")
  endforeach()
  execute_process(COMMAND ${_command} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _rc STREQUAL "0")
    message(FATAL_ERROR "Failed: ${ARGV}\n${_out}\n${_err}")
  endif()
  set(_log "${_out}\n${_err}" PARENT_SCOPE)
endfunction()
function(reject pattern)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(_rc STREQUAL "0" OR NOT "${_out}\n${_err}" MATCHES "${pattern}")
    message(FATAL_ERROR "Expected rejection matching '${pattern}': ${ARGN}\n${_out}\n${_err}")
  endif()
endfunction()
function(expect json expected)
  string(JSON _value GET "${json}" ${ARGN})
  if(NOT "${_value}" STREQUAL "${expected}")
    message(FATAL_ERROR "${ARGN}: expected '${expected}', got '${_value}'")
  endif()
endfunction()
function(check_rust metadata config)
  expect("${metadata}" rust backend)
  expect("${metadata}" "${config}" configuration)
  if(config STREQUAL "Debug")
    set(_profile dev)
  else()
    set(_profile release)
  endif()
  expect("${metadata}" "${_profile}" cargo_profile)
  expect("${metadata}" rust-fixture cargo_package)
  expect("${metadata}" "${_source}/Cargo.toml" cargo_manifest)
  expect("${metadata}" bin cargo_target_kind)
  expect("${metadata}" fixture-benchmark cargo_target_name)
  expect("${metadata}" 2021 rust_edition)
  expect("${metadata}" TRUE cargo_no_default_features)
  string(JSON _features GET "${metadata}" cargo_features_requested)
  expect("${_features}" answer 0)
  expect("${_features}" benchmark 1)
  string(JSON _flags GET "${metadata}" rustflags_explicit)
  expect("${_flags}" --cfg 0)
  expect("${_flags}" "cmake_fixture=\"value with spaces\"" 1)
  foreach(_tool IN ITEMS rustc cargo)
    string(JSON _path GET "${metadata}" ${_tool})
    run("${_path}" --version --verbose)
    string(REGEX MATCH "release: ([^\r\n]+)" _match "${_log}")
    expect("${metadata}" "${CMAKE_MATCH_1}" ${_tool}_version)
    if(_tool STREQUAL "rustc")
      string(REGEX MATCH "host: ([^\r\n]+)" _match "${_log}")
      expect("${metadata}" "${CMAKE_MATCH_1}" rust_host)
      expect("${metadata}" "${CMAKE_MATCH_1}" rust_target)
      run("${_path}" --print sysroot)
      string(STRIP "${_log}" _sysroot)
      expect("${metadata}" "${_sysroot}" rust_sysroot)
    endif()
  endforeach()
  # Exact key whitelist prevents policy/allocator/compiler leakage or fabricated
  # resolved features, even if a newly added C++ policy uses a different name.
  set(_allowed backend target compiler generator project configuration rustc rustc_version cargo cargo_version
    rust_host rust_sysroot cargo_manifest cargo_package cargo_target_kind cargo_target_name rust_edition cargo_profile
    rust_target cargo_no_default_features cargo_target_dir cargo_build_id cargo_build_target cargo_features_requested rustflags_explicit
    rust_opt_level rust_lto_mode rust_debug_info rust_codegen_units rust_incremental
    rust_enable_native rust_frame_pointers)
  string(JSON _count LENGTH "${metadata}")
  math(EXPR _last "${_count}-1")
  foreach(_i RANGE ${_last})
    string(JSON _key MEMBER "${metadata}" ${_i})
    if(NOT _key IN_LIST _allowed)
      message(FATAL_ERROR "Unexpected Rust provenance field: ${_key}")
    endif()
  endforeach()
endfunction()
function(check_cpp metadata format)
  expect("${metadata}" cxx backend)
  foreach(_key IN LISTS EXPECTED_CXX_KEYS)
    expect("${metadata}" "${EXPECTED_${_key}}" "${_key}")
  endforeach()
  list(LENGTH EXPECTED_CXX_KEYS _expected_count)
  if(format STREQUAL "harness")
    math(EXPR _expected_count "${_expected_count}+6")
    expect("${metadata}" minimal policies)
    expect("${metadata}" "${EXPECTED_CXX_COMPILER}" compiler)
    expect("${metadata}" cpp_bench target)
    expect("${metadata}" RustFixture project)
    expect("${metadata}" "${CHECK_GENERATOR}" generator)
  else()
    math(EXPR _expected_count "${_expected_count}+2")
    expect("${metadata}" "${EXPECTED_CXX_PATH}" CMAKE_CXX_COMPILER)
    if(DEFINED EXPECTED_CXX_ALLOCATOR)
      math(EXPR _expected_count "${_expected_count}+1")
      expect("${metadata}" "${EXPECTED_CXX_ALLOCATOR}" BOILERPLATE_ALLOCATOR)
    endif()
  endif()
  string(JSON _count LENGTH "${metadata}")
  if(NOT _count EQUAL _expected_count)
    message(FATAL_ERROR "C++ ${format} metadata keys changed: ${metadata}")
  endif()
endfunction()

set(_tools)
foreach(_key IN ITEMS TOOLCHAIN CARGO RUSTC)
  if(CHECK_RUST_${_key})
    list(APPEND _tools "-DBOILERPLATE_RUST_${_key}=${CHECK_RUST_${_key}}")
  endif()
endforeach()
run("${CMAKE_COMMAND}" -S "${_source}" -B "${CHECK_BINARY}/disabled" -G "${CHECK_GENERATOR}"
  "-DTOOLKIT_DIR=${_toolkit}" -DFIXTURE_RUST=OFF -DCMAKE_BUILD_TYPE=Debug
  -DBOILERPLATE_RUST_CARGO=/no-rust/cargo -DBOILERPLATE_RUST_RUSTC=/no-rust/rustc)
run("${CMAKE_COMMAND}" --build "${CHECK_BINARY}/disabled" --config Debug --target run_cpp_harness run_cpp_scenario check)
reject("Rust PGO is not implemented" "${CMAKE_COMMAND}" -S "${_source}" -B "${CHECK_BINARY}/pgo"
  -G "${CHECK_GENERATOR}" "-DTOOLKIT_DIR=${_toolkit}" -DCMAKE_BUILD_TYPE=Debug
  -DCMAKE_CONFIGURATION_TYPES=Debug -DFIXTURE_RUST_PGO=ON ${_tools})
run("${CMAKE_COMMAND}" -S "${_source}" -B "${_build}" -G "${CHECK_GENERATOR}"
  "-DTOOLKIT_DIR=${_toolkit}" -DCMAKE_BUILD_TYPE=Debug "-DCMAKE_CONFIGURATION_TYPES=Debug;Release" ${_tools})
include("${_build}/expected-cxx.cmake")
set(_configs Debug)
if(CHECK_GENERATOR MATCHES "Multi-Config|Visual Studio|Xcode")
  list(APPEND _configs Release)
endif()
foreach(_config IN LISTS _configs)
  # Run a harness before any general build: the imported target and generated
  # Rust include file must both be built via the original harness dependency.
  run("${CMAKE_COMMAND}" --build "${_build}" --config "${_config}" --target
    run_rust_harness run_rust_json run_rust_none run_cpp_harness run_cpp_scenario)
  set(_root "${_build}/harness-results/${_config}")
  file(READ "${_root}/rust_harness/manifest.json" _manifest)
  string(JSON _metadata GET "${_manifest}" metadata)
  check_rust("${_metadata}" "${_config}")
  string(JSON _version GET "${_metadata}" rustc_version)
  expect("${_manifest}" "rustc-${_version}" compiler)
  file(READ "${_build}/bench-${_config}.txt" _binary)
  expect("${_manifest}" "${_binary}" binary)
  file(SHA256 "${_binary}" _hash)
  expect("${_manifest}" "${_hash}" binary_sha256)
  string(JSON _id GET "${_metadata}" cargo_build_id)
  string(FIND "${_binary}" "rust_bench-${_id}/${_config}/" _pos)
  if(_pos LESS 0)
    message(FATAL_ERROR "Build identity does not describe the imported artifact")
  endif()
  file(READ "${_root}/rust_harness/summary.json" _summary)
  expect("${_summary}" passed status)
  foreach(_case IN ITEMS small large)
    if(_case STREQUAL "small")
      set(_items 4000000)
      set(_checksum 20)
    else()
      set(_items 8000000)
      set(_checksum 72)
    endif()
    expect("${_summary}" 2 cases ${_case} metrics items count)
    expect("${_summary}" "${_items}" cases ${_case} metrics items min)
    expect("${_summary}" "${_items}" cases ${_case} metrics items max)
    expect("${_summary}" "${_checksum}" cases ${_case} invariants checksum)
  endforeach()
  file(STRINGS "${_root}/rust_harness/runs.jsonl" _records)
  list(LENGTH _records _count)
  if(NOT _count EQUAL 6)
    message(FATAL_ERROR "Warmup/measured round count changed")
  endif()
  file(READ "${_root}/rust_json/summary.json" _json_summary)
  expect("${_json_summary}" 20 cases default invariants checksum)
  file(READ "${_root}/rust_none/summary.json" _none_summary)
  expect("${_none_summary}" passed status)
  file(READ "${_root}/cpp_harness/manifest.json" _cpp)
  string(JSON _metadata_cpp GET "${_cpp}" metadata)
  check_cpp("${_metadata_cpp}" harness)
  expect("${_cpp}" "${EXPECTED_CXX_COMPILER}" compiler)
  file(READ "${_root}/cpp_harness/summary.json" _cpp_summary)
  expect("${_cpp_summary}" 4000000 cases default metrics items min)
  expect("${_cpp_summary}" 20 cases default invariants checksum)
  file(GLOB _cpp_reports "${_build}/results/${_config}/cpp_scenario/*/result.json")
  list(GET _cpp_reports 0 _report)
  file(READ "${_report}" _cpp)
  string(JSON _metadata_cpp GET "${_cpp}" build_knobs)
  check_cpp("${_metadata_cpp}" scenario)
  expect("${_cpp}" "${EXPECTED_CXX_SCENARIO_COMPILER}" compiler)
  expect("${_cpp}" "${EXPECTED_CXX_PROFILE}" profile)
  foreach(_pair IN ITEMS "invalid|parser-error" "unstable|invariant checksum changed" "failed|failed ")
    string(REPLACE "|" ";" _pair "${_pair}")
    list(GET _pair 0 _name)
    list(GET _pair 1 _pattern)
    reject("${_pattern}" "${CMAKE_COMMAND}" --build "${_build}" --config "${_config}" --target run_rust_${_name})
  endforeach()
  run("${CMAKE_COMMAND}" --build "${_build}" --config "${_config}" --target run_rust_first)
  file(GLOB _first "${_build}/results/${_config}/rust_first/*/result.json")
  file(GLOB _second "${_build}/results/${_config}/rust_second/*/result.json")
  list(LENGTH _first _count)
  if(NOT _count EQUAL 1 OR _second)
    message(FATAL_ERROR "Individual Rust scenario ran siblings or produced no result")
  endif()
  list(GET _first 0 _report)
  file(READ "${_report}" _scenario)
  string(JSON _metadata_scenario GET "${_scenario}" build_knobs)
  check_rust("${_metadata_scenario}" "${_config}")
  expect("${_scenario}" "rustc-${_version}" compiler)
  expect("${_scenario}" "${_hash}" executable_sha256)
  expect("${_scenario}" "${_config}" config)
  expect("${_scenario}" json args 0)
  expect("${_scenario}" 4 args 1)
  string(JSON _count LENGTH "${_scenario}" runs)
  if(NOT _count EQUAL 3)
    message(FATAL_ERROR "Rust scenario repetition count changed")
  endif()
  expect("${_scenario}" ON runs 0 warmup)
  expect("${_scenario}" OFF runs 1 warmup)
  run("${CMAKE_COMMAND}" --build "${_build}" --config "${_config}" --target run_group_rust_benchmarks check)
  file(GLOB _second "${_build}/results/${_config}/rust_second/*/result.json")
  if(NOT _second)
    message(FATAL_ERROR "Rust scenario group omitted its second member")
  endif()
  run("${CMAKE_CTEST_COMMAND}" --test-dir "${_build}" -C "${_config}" -R "^rust_first_smoke$" -V)
  if(NOT _log MATCHES "checksum.*6" OR NOT _log MATCHES "100% tests passed")
    message(FATAL_ERROR "Rust scenario smoke did not run in CTest: ${_log}")
  endif()
  foreach(_target IN ITEMS run_rust_blocked run_rust_blocked_scenario)
    reject("CROSSCOMPILING_EMULATOR" "${CMAKE_COMMAND}" --build "${_build}" --config "${_config}" --target ${_target})
  endforeach()
  run("${CMAKE_COMMAND}" --build "${_build}" --config "${_config}" --target run_rust_emulated run_rust_emulated_scenario)
  message(STATUS "${CHECK_GENERATOR} ${_config}: C++ compatibility, Rust provenance, parsers/invariants, dependency ordering, scenarios/groups/smoke, hashes and execution gates passed")
endforeach()
message(STATUS "Rust benchmark checks passed; disabled-Rust compatibility and explicit Rust PGO rejection passed")
