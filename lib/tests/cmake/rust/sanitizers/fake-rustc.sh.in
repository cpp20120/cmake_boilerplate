#!/bin/sh
case "$1" in
  --version)
    printf '%s\n' 'rustc 1.99.0@CHANNEL@ (fake)' 'release: 1.99.0@CHANNEL@' 'host: @TRIPLE@'
    exit 0 ;;
  --print)
    if [ "$2" = sysroot ]; then
      printf '%s\n' '@FAKE_SYSROOT@'
      exit 0
    fi ;;
esac
printf '%s\n' 'Unexpected fake rustc invocation' >&2
exit 12
