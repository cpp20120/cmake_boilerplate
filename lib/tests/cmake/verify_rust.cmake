cmake_minimum_required(VERSION 3.26)
if(NOT CHECK_BINARY)
  message(FATAL_ERROR "Pass -DCHECK_BINARY=<temporary build directory>")
endif()
if(NOT CHECK_GENERATOR)
  set(CHECK_GENERATOR Ninja)
endif()
get_filename_component(_toolkit "${CMAKE_CURRENT_LIST_DIR}/../../cmake" ABSOLUTE)
set(_source "${CHECK_BINARY}/source with spaces")
set(_build "${CHECK_BINARY}/build with spaces")
# Start with clean fixture artifacts on repeat invocations. Restoring an older
# source mtime over a prior edit can otherwise legitimately fool Cargo freshness.
file(REMOVE_RECURSE "${_source}" "${_build}")
file(MAKE_DIRECTORY "${_source}")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/rust/" DESTINATION "${_source}"
  PATTERN out EXCLUDE PATTERN target EXCLUDE)
function(run)
  set(_command)
  math(EXPR _last "${ARGC}-1")
  foreach(_index RANGE ${_last})
    string(REPLACE ";" "\\;" _argument "${ARGV${_index}}")
    list(APPEND _command "${_argument}")
  endforeach()
  execute_process(COMMAND ${_command} RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
  if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Command failed: ${ARGV}\n${_output}\n${_error}")
  endif()
  set(_log "${_output}\n${_error}" PARENT_SCOPE)
endfunction()
function(fail name pattern)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_source}" -B "${CHECK_BINARY}/fail-${name}"
    -G "${CHECK_GENERATOR}" "-DTOOLKIT_DIR=${_toolkit}" -DCMAKE_BUILD_TYPE=Debug
    "-DCMAKE_CONFIGURATION_TYPES=Debug;Release" ${ARGN}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
  if(_result STREQUAL "0" OR NOT "${_output}\n${_error}" MATCHES "${pattern}")
    message(FATAL_ERROR "Expected ${name} failure matching '${pattern}':\n${_output}\n${_error}")
  endif()
endfunction()
set(_tools)
foreach(_key IN ITEMS TOOLCHAIN CARGO RUSTC)
  if(CHECK_RUST_${_key})
    list(APPEND _tools "-DBOILERPLATE_RUST_${_key}=${CHECK_RUST_${_key}}")
  endif()
endforeach()

# Neither invalid Rust overrides nor an unavailable toolchain may affect C++.
run("${CMAKE_COMMAND}" -S "${_source}" -B "${CHECK_BINARY}/disabled" -G "${CHECK_GENERATOR}"
  "-DTOOLKIT_DIR=${_toolkit}" -DFIXTURE_RUST=OFF -DCMAKE_BUILD_TYPE=Debug
  -DBOILERPLATE_RUST_CARGO=/no-rust/cargo -DBOILERPLATE_RUST_RUSTC=/no-rust/rustc)
run("${CMAKE_COMMAND}" --build "${CHECK_BINARY}/disabled" --config Debug --target check)
message(STATUS "Rust disabled: C++ configure/build/check passed with unavailable Rust tools")

fail(missing "Rust cargo not found" -DBOILERPLATE_RUST_CARGO=/no-rust/cargo)
file(MAKE_DIRECTORY "${CHECK_BINARY}/fake-a" "${CHECK_BINARY}/fake-b")
file(WRITE "${CHECK_BINARY}/fake-a/cargo" "not executed")
file(WRITE "${CHECK_BINARY}/fake-b/rustc" "not executed")
fail(mixed "Incompatible Rust toolchain"
  "-DBOILERPLATE_RUST_CARGO=${CHECK_BINARY}/fake-a/cargo"
  "-DBOILERPLATE_RUST_RUSTC=${CHECK_BINARY}/fake-b/rustc")
fail(profile "Rust configuration.*must be" ${_tools}
  -DCMAKE_BUILD_TYPE=MinSizeRel -DCMAKE_CONFIGURATION_TYPES=MinSizeRel)
fail(policy "target policies cannot be applied" ${_tools} -DFIXTURE_BAD_POLICY=ON)
fail(lifecycle "before boilerplate_finalize_project" ${_tools} -DFIXTURE_LATE_TARGET=ON)

# Exercise Cargo's declared minimum compiler requirement without requiring an
# obsolete Rust installation on the test host.
file(READ "${_source}/Cargo.toml" _manifest)
string(REPLACE "rust-version = \"1.74\"" "rust-version = \"1.999\"" _future_manifest "${_manifest}")
file(WRITE "${_source}/Cargo.toml" "${_future_manifest}")
fail(minimum "requires Rust 1.999" ${_tools})
file(WRITE "${_source}/Cargo.toml" "${_manifest}")

run("${CMAKE_COMMAND}" -S "${_source}" -B "${_build}" -G "${CHECK_GENERATOR}"
  "-DTOOLKIT_DIR=${_toolkit}" -DCMAKE_BUILD_TYPE=Debug "-DCMAKE_CONFIGURATION_TYPES=Debug;Release" ${_tools})
if(NOT _log MATCHES "Boilerplate Rust: Cargo.*rustc.*host=.*sysroot=")
  message(FATAL_ERROR "Toolchain identity was not reported")
endif()
# The fixture deliberately mutates CC *during test registration*. Its CTest
# environment must still match the snapshot captured by the Rust producer.
if(NOT DEFINED ENV{CC})
  file(READ "${_build}/CTestTestfile.cmake" _ctest_entries)
  if(NOT _ctest_entries MATCHES "CC=unset:")
    message(FATAL_ERROR "CTest did not normalize CC against the Rust target fingerprint")
  endif()
endif()
run("${CMAKE_COMMAND}" --build "${_build}" --config Debug --target run_rust copy_rust)
if(NOT _log MATCHES "answer=42" OR NOT _log MATCHES "example=42" OR NOT EXISTS "${_build}/prerequisite")
  message(FATAL_ERROR "Imported executable build ordering or TARGET_FILE failed: ${_log}")
endif()
file(READ "${_build}/binary-Debug.txt" _binary)
file(READ "${_build}/example-Debug.txt" _example)
if(NOT EXISTS "${_binary}" OR NOT EXISTS "${_example}" OR _binary STREQUAL _example)
  message(FATAL_ERROR "Missing/distinct imported executable paths")
endif()
file(TIMESTAMP "${_binary}" _before "%s")
run("${CMAKE_COMMAND}" -E sleep 1)
run("${CMAKE_COMMAND}" --build "${_build}" --config Debug --target run_rust)
file(TIMESTAMP "${_binary}" _after "%s")
if(NOT _before STREQUAL _after OR _log MATCHES "Compiling rust-fixture")
  message(FATAL_ERROR "Cargo recompiled unchanged sources: ${_log}")
endif()
message(STATUS "Cargo freshness: repeated build left executable timestamp unchanged")
file(READ "${_source}/src/lib.rs" _rust_source)
string(REPLACE "42" "43" _rust_source "${_rust_source}")
file(WRITE "${_source}/src/lib.rs" "${_rust_source}")
run("${CMAKE_COMMAND}" --build "${_build}" --config Debug --target run_rust copy_rust)
if(NOT _log MATCHES "Compiling rust-fixture" OR NOT _log MATCHES "answer=43")
  message(FATAL_ERROR "Cargo missed a Rust source change: ${_log}")
endif()
run("${CMAKE_COMMAND}" --build "${_build}" --config Debug --target check)
run("${CMAKE_CTEST_COMMAND}" --test-dir "${_build}" -C Debug -R rust_suite -V)
# Reproduce launchers that add CC for CTest only. The test should run using
# the same environment fingerprint as its prebuilt Cargo artifacts.
if(NOT DEFINED ENV{CC})
  run("${CMAKE_COMMAND}" -E env "CC=/not/a/compiler" "${CMAKE_CTEST_COMMAND}"
    --test-dir "${_build}" -C Debug -R rust_suite -V)
endif()
if(NOT _log MATCHES "returns_answer.*ok" OR NOT _log MATCHES "100% tests passed")
  message(FATAL_ERROR "CTest did not execute the Cargo suite: ${_log}")
endif()
if(CHECK_QUALITY)
  run("${CMAKE_COMMAND}" --build "${_build}" --config Debug --target rust-format-check rust-clippy)
endif()
if(CHECK_GENERATOR MATCHES "Multi-Config|Visual Studio|Xcode")
  run("${CMAKE_COMMAND}" --build "${_build}" --config Release --target run_rust copy_rust check)
  file(READ "${_build}/binary-Release.txt" _release)
else()
  # Reconfiguring the same tree must retain an isolated Debug artifact.
  run("${CMAKE_COMMAND}" -S "${_source}" -B "${_build}" -DCMAKE_BUILD_TYPE=Release)
  run("${CMAKE_COMMAND}" --build "${_build}" --target run_rust copy_rust check)
  file(READ "${_build}/binary-Release.txt" _release)
endif()
if(_release STREQUAL _binary OR NOT EXISTS "${_release}" OR NOT EXISTS "${_binary}")
  message(FATAL_ERROR "Debug and Release artifacts were not isolated")
endif()
message(STATUS "Rust ${CHECK_GENERATOR}: imports, prerequisites, freshness, source changes, tests, configuration isolation and diagnostics passed")
