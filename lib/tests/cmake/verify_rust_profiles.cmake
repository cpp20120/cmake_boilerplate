cmake_minimum_required(VERSION 3.26)
if(NOT CHECK_BINARY)
  message(FATAL_ERROR "Pass -DCHECK_BINARY=<temporary directory>")
endif()
if(NOT CHECK_GENERATOR)
  set(CHECK_GENERATOR Ninja)
endif()
get_filename_component(_toolkit "${CMAKE_CURRENT_LIST_DIR}/../../cmake" ABSOLUTE)
set(_source "${CMAKE_CURRENT_LIST_DIR}/rust")
set(_build "${CHECK_BINARY}/variants")
function(run)
  set(_command)
  math(EXPR _last "${ARGC}-1")
  foreach(_i RANGE ${_last})
    string(REPLACE ";" "\\;" _argument "${ARGV${_i}}")
    list(APPEND _command "${_argument}")
  endforeach()
  execute_process(COMMAND ${_command} RESULT_VARIABLE _result
    OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Rust Stage 2B command failed: ${ARGN}\n${_out}\n${_err}")
  endif()
  set(_log "${_out}\n${_err}" PARENT_SCOPE)
endfunction()
function(reject pattern)
  set(_command)
  math(EXPR _last "${ARGC}-1")
  foreach(_i RANGE 1 ${_last})
    string(REPLACE ";" "\\;" _argument "${ARGV${_i}}")
    list(APPEND _command "${_argument}")
  endforeach()
  execute_process(COMMAND ${_command} RESULT_VARIABLE _result
    OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(_result STREQUAL "0" OR NOT "${_out}\n${_err}" MATCHES "${pattern}")
    message(FATAL_ERROR "Expected rejection '${pattern}': ${ARGN}\n${_out}\n${_err}")
  endif()
endfunction()
set(_tools)
foreach(_name IN ITEMS CARGO RUSTC TOOLCHAIN)
  if(CHECK_RUST_${_name})
    list(APPEND _tools "-DBOILERPLATE_RUST_${_name}=${CHECK_RUST_${_name}}")
  endif()
endforeach()
file(REMOVE_RECURSE "${CHECK_BINARY}")
if(CHECK_GENERATOR MATCHES "Multi-Config")
  set(_cfgs "Debug;Release;RelWithDebInfo")
  set(_build_config Release)
else()
  set(_build_config Release)
endif()
run("${CMAKE_COMMAND}" -S "${_source}" -B "${_build}" -G "${CHECK_GENERATOR}"
  "-DTOOLKIT_DIR=${_toolkit}" -DCMAKE_BUILD_TYPE=Release
  "-DCMAKE_CONFIGURATION_TYPES=Debug;Release;RelWithDebInfo"
  -DFIXTURE_PROFILE_VARIANTS=ON ${_tools})
foreach(_target IN ITEMS rust_variant_fast rust_variant_small)
  set(_config "${_build}/rust/${_target}/${_build_config}/cargo.cmake")
  if(NOT EXISTS "${_config}")
    message(FATAL_ERROR "Missing generated Cargo variant config: ${_config}")
  endif()
  file(READ "${_config}" _text)
  if(NOT _text MATCHES "CARGO_PROFILE_RELEASE_" OR NOT _text MATCHES "--profile;release")
    message(FATAL_ERROR "Variant ${_target} did not receive the correct Cargo profile: ${_text}")
  endif()
  if(_target STREQUAL "rust_variant_fast")
    if(NOT _text MATCHES "CARGO_PROFILE_RELEASE_OPT_LEVEL=3" OR
        NOT _text MATCHES "CARGO_PROFILE_RELEASE_LTO=thin" OR
        NOT _text MATCHES "CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1" OR
        NOT _text MATCHES "force-frame-pointers=yes")
      message(FATAL_ERROR "Rust fast policy was not correctly lowered: ${_text}")
    endif()
  else()
    if(NOT _text MATCHES "CARGO_PROFILE_RELEASE_OPT_LEVEL=z" OR
        NOT _text MATCHES "CARGO_PROFILE_RELEASE_LTO=off" OR
        NOT _text MATCHES "CARGO_PROFILE_RELEASE_CODEGEN_UNITS=8")
      message(FATAL_ERROR "Rust small policy was not correctly lowered: ${_text}")
    endif()
  endif()
  file(STRINGS "${_config}" _dir_line REGEX "^set[(]RUST_TARGET_DIR ")
  set(_dir_${_target} "${_dir_line}")
endforeach()
if(_dir_rust_variant_fast STREQUAL _dir_rust_variant_small)
  message(FATAL_ERROR "Conflicting Rust variants share an artifact directory")
endif()
run("${CMAKE_COMMAND}" --build "${_build}" --config "${_build_config}" --parallel 2
  --target rust_variant_fast_cargo rust_variant_small_cargo)
run("${CMAKE_COMMAND}" --build "${_build}" --config "${_build_config}"
  --target run_rust_variants)
if(NOT _log MATCHES "answer=42")
  message(FATAL_ERROR "Variants did not execute correctly: ${_log}")
endif()
if(CHECK_GENERATOR MATCHES "Multi-Config")
  run("${CMAKE_COMMAND}" --build "${_build}" --config RelWithDebInfo
    --target rust_variant_fast_cargo)
  file(READ "${_build}/rust/rust_variant_fast/RelWithDebInfo/cargo.cmake" _rel)
  if(NOT _rel MATCHES "CARGO_PROFILE_RELEASE_DEBUG=2" OR NOT _rel MATCHES "CARGO_PROFILE_RELEASE_OPT_LEVEL=3")
    message(FATAL_ERROR "RelWithDebInfo must include Rust debuginfo and optimized release: ${_rel}")
  endif()
endif()
# Rust-only project must not require a C++ compiler, even for ThinLTO.
run("${CMAKE_COMMAND}" -S "${_source}/only" -B "${CHECK_BINARY}/only" -G Ninja
  "-DTOOLKIT_DIR=${_toolkit}" -DBOILERPLATE_PROFILE=lto ${_tools})
run("${CMAKE_COMMAND}" --build "${CHECK_BINARY}/only" --target rust_only_cargo)
# Unsupported policy and reserved Cargo profile must fail at configure time.
reject("unsupported policy option UNITY_BUILD" "${CMAKE_COMMAND}" -S "${_source}"
  -B "${CHECK_BINARY}/bad-policy" -G Ninja "-DTOOLKIT_DIR=${_toolkit}"
  -DCMAKE_BUILD_TYPE=Release -DFIXTURE_PROFILE_VARIANTS=ON -DFIXTURE_BAD_RUST_POLICY=ON ${_tools})
reject("invalid/reserved" "${CMAKE_COMMAND}" -S "${_source}"
  -B "${CHECK_BINARY}/bad-profile" -G Ninja "-DTOOLKIT_DIR=${_toolkit}"
  -DCMAKE_BUILD_TYPE=Release -DFIXTURE_PROFILE_VARIANTS=ON -DFIXTURE_BAD_RUST_PROFILE=ON ${_tools})
message(STATUS "Rust Stage 2B: variants, profiles, Rust-only, policy rejection passed (${CHECK_GENERATOR})")
