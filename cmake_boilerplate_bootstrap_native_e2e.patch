diff --git a/scripts/test-package-selection.cmake b/scripts/test-package-selection.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..d170af0b7612c559fa7df2c722826887cf84e369
--- /dev/null
+++ b/scripts/test-package-selection.cmake
@@ -0,0 +1,44 @@
+cmake_minimum_required(VERSION 3.26)
+if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
+  message(STATUS "Native Linux package selection checks are Linux-only")
+  return()
+endif()
+get_filename_component(_source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
+if(NOT CHECK_BINARY)
+  set(CHECK_BINARY "${CMAKE_CURRENT_BINARY_DIR}/out/package-selection-test")
+endif()
+file(MAKE_DIRECTORY "${CHECK_BINARY}/fake-tools")
+# Both backends are deliberately 'installed', regardless of OS family. This
+# reproduces the original bug and asserts it cannot recur.
+foreach(_tool IN ITEMS rpmbuild dpkg-deb)
+  file(WRITE "${CHECK_BINARY}/fake-tools/${_tool}" "#!/bin/sh\nexit 0\n")
+  file(CHMOD "${CHECK_BINARY}/fake-tools/${_tool}"
+    PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
+endforeach()
+foreach(_case IN ITEMS "debian|ID=ubuntu|TGZ,DEB" "rpm|ID=fedora|TGZ,RPM"
+    "arch|ID=cachyos|TGZ" "unknown|ID=custom|TGZ")
+  string(REPLACE "|" ";" _fields "${_case}")
+  list(GET _fields 0 _label)
+  list(GET _fields 1 _release)
+  list(GET _fields 2 _wanted)
+  string(REPLACE "," ";" _wanted "${_wanted}")
+  string(REPLACE ";" "\\;" _encoded "${_wanted}")
+  file(WRITE "${CHECK_BINARY}/${_label}.os-release" "${_release}\n")
+  execute_process(COMMAND "${CMAKE_COMMAND}" -E env
+    "PATH=${CHECK_BINARY}/fake-tools:$ENV{PATH}"
+    "${CMAKE_COMMAND}" -S "${_source}" -B "${CHECK_BINARY}/${_label}"
+    -G Ninja -DENABLE_PACKAGING=ON
+    "-DBOILERPLATE_OS_RELEASE_FILE=${CHECK_BINARY}/${_label}.os-release"
+    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
+  if(NOT _result EQUAL 0)
+    message(FATAL_ERROR "${_label} configure failed: ${_out}\n${_err}")
+  endif()
+  file(STRINGS "${CHECK_BINARY}/${_label}/CPackConfig.cmake" _actual
+    REGEX "^set\\(CPACK_GENERATOR ")
+  if(NOT _actual STREQUAL "set(CPACK_GENERATOR \"${_encoded}\")")
+    message(FATAL_ERROR "${_label}: expected ${_wanted}, observed ${_actual}")
+  endif()
+  message(STATUS "${_label}: ${_wanted}")
+endforeach()
+file(REMOVE_RECURSE "${CHECK_BINARY}")
+message(STATUS "Native Linux package selection regression passed")
diff --git a/scripts/verify-package.cmake b/scripts/verify-package.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..0c83a596611bcd33ebbb79811bd7a40969fafdc6
--- /dev/null
+++ b/scripts/verify-package.cmake
@@ -0,0 +1,53 @@
+cmake_minimum_required(VERSION 3.26)
+if(NOT PACKAGE_DIR OR NOT PACKAGE_FORMAT)
+  message(FATAL_ERROR "Set PACKAGE_DIR and PACKAGE_FORMAT")
+endif()
+set(_pattern "")
+if(PACKAGE_FORMAT STREQUAL "ARCH")
+  set(_pattern "*.pkg.tar.zst")
+elseif(PACKAGE_FORMAT STREQUAL "DEB")
+  set(_pattern "*.deb")
+elseif(PACKAGE_FORMAT STREQUAL "RPM")
+  set(_pattern "*.rpm")
+elseif(PACKAGE_FORMAT STREQUAL "TGZ")
+  set(_pattern "*.tar.gz")
+elseif(PACKAGE_FORMAT STREQUAL "NSIS")
+  set(_pattern "*.exe")
+elseif(PACKAGE_FORMAT STREQUAL "DragNDrop")
+  set(_pattern "*.dmg")
+elseif(PACKAGE_FORMAT STREQUAL "ZIP")
+  set(_pattern "*.zip")
+else()
+  message(FATAL_ERROR "Unknown package format ${PACKAGE_FORMAT}")
+endif()
+file(GLOB _artifacts "${PACKAGE_DIR}/${_pattern}")
+if(NOT _artifacts)
+  message(FATAL_ERROR "Expected ${_pattern} in ${PACKAGE_DIR}")
+endif()
+foreach(_artifact IN LISTS _artifacts)
+  file(SIZE "${_artifact}" _size)
+  if(_size LESS 100)
+    message(FATAL_ERROR "Package empty: ${_artifact}")
+  endif()
+  if(PACKAGE_FORMAT STREQUAL "ARCH")
+    find_program(_bsdtar bsdtar REQUIRED)
+    execute_process(COMMAND "${_bsdtar}" -tf "${_artifact}"
+      OUTPUT_VARIABLE _contents RESULT_VARIABLE _rc ERROR_VARIABLE _err)
+    if(NOT _rc EQUAL 0 OR NOT _contents MATCHES "(^|\n)usr/bin/[^\n]+")
+      message(FATAL_ERROR "Invalid native Arch package content: ${_artifact}: ${_err}")
+    endif()
+  elseif(PACKAGE_FORMAT STREQUAL "DEB")
+    execute_process(COMMAND dpkg-deb --contents "${_artifact}"
+      RESULT_VARIABLE _rc OUTPUT_VARIABLE _contents ERROR_VARIABLE _err)
+    if(NOT _rc EQUAL 0 OR NOT _contents MATCHES "usr/bin/")
+      message(FATAL_ERROR "Invalid DEB payload: ${_artifact}: ${_err}")
+    endif()
+  elseif(PACKAGE_FORMAT STREQUAL "RPM")
+    execute_process(COMMAND rpm -qpl "${_artifact}"
+      RESULT_VARIABLE _rc OUTPUT_VARIABLE _contents ERROR_VARIABLE _err)
+    if(NOT _rc EQUAL 0 OR NOT _contents MATCHES "/usr/bin/")
+      message(FATAL_ERROR "Invalid RPM payload: ${_artifact}: ${_err}")
+    endif()
+  endif()
+  message(STATUS "Verified ${PACKAGE_FORMAT}: ${_artifact} (${_size} bytes)")
+endforeach()
