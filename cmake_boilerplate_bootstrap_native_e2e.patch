@@ -0,0 +1,13 @@
+# Generated from configured CMake package metadata. Build was already completed.
+pkgname=@PKGNAME@
+pkgver=@PKGVER@
+pkgrel=1
+pkgdesc=@PKGDESC@
+arch=("$CARCH")
+license=(@PKGLICENSE@)
+source=()
