--- /dev/null
+++ b/.github/workflows/bootstrap-e2e.yml
@@ -0,0 +1,127 @@
+name: Bootstrap E2E (native distribution packages)
+on:
+  push:
+    branches: [main, master]
+  pull_request:
+    branches: [main, master]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  native-hosts:
+    name: ${{ matrix.system }} setup-init-build-test-run-package
+    runs-on: ${{ matrix.runner }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - {system: ubuntu-deb, runner: ubuntu-24.04, format: DEB}
+          - {system: macos-dmg, runner: macos-15, format: DragNDrop}
+          - {system: windows-nsis, runner: windows-2022, format: NSIS}
+    steps:
+      - uses: actions/checkout@v4
+      - name: Ensure MSVC toolchain is activated
+        if: runner.os == 'Windows'
+        uses: ilammy/msvc-dev-cmd@v1
+        with:
+          arch: x64
+      # Windows Server runners provide Chocolatey; setup-host.ps1 falls back
+      # to it automatically when the WinGet executable is unavailable.
+      - name: Bootstrap → init → build → CTest → run → native packaging (Unix)
+        if: runner.os != 'Windows'
+        shell: bash
+        run: |
+          set -euo pipefail
+          ./setup.sh --init BootstrapSmoke --output "$RUNNER_TEMP/bootstrap smoke" --package --run --jobs 2
+          cmake "-DPACKAGE_DIR=$RUNNER_TEMP/bootstrap smoke/out/packages/app-release" "-DPACKAGE_FORMAT=${{ matrix.format }}" -P scripts/verify-package.cmake
+          # The generator also copied the user-facing entry point to the new project.
+          test -f "$RUNNER_TEMP/bootstrap smoke/setup.sh"
+      - name: Bootstrap → init → build → CTest → run → native packaging (Windows)
+        if: runner.os == 'Windows'
+        shell: pwsh
+        run: |
+          $env:PATH += ';C:\Program Files (x86)\NSIS'
+          ./setup.ps1 -Init BootstrapSmoke -Output "$env:RUNNER_TEMP\bootstrap smoke" -Package -Run -Jobs 2
+          if ($LASTEXITCODE -ne 0) { throw 'Windows bootstrap failed' }
+          cmake "-DPACKAGE_DIR=$env:RUNNER_TEMP\bootstrap smoke\out\packages\app-release" '-DPACKAGE_FORMAT=NSIS' -P scripts/verify-package.cmake
+          if ($LASTEXITCODE -ne 0) { throw 'Missing Windows package' }
+      - uses: actions/upload-artifact@v4
+        with:
+          name: native-${{ matrix.system }}
+          path: ${{ runner.temp }}/bootstrap smoke/out/packages/app-release/
+          if-no-files-found: error
+
+  linux-containers:
+    name: ${{ matrix.system }} setup-init-build-test-run-package
+    runs-on: ubuntu-24.04
+    container:
+      image: ${{ matrix.image }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - {system: debian-deb, image: 'debian:stable', format: DEB}
+          - {system: fedora-rpm, image: 'fedora:43', format: RPM}
+          - {system: arch-pacman, image: 'archlinux:base-devel', format: ARCH}
+    steps:
+      - name: Ensure checkout prerequisites (Debian)
+        if: matrix.format == 'DEB'
+        run: |
+          apt-get update
+          apt-get install -y --no-install-recommends ca-certificates git tar gzip
+      - name: Ensure checkout prerequisites (Fedora)
+        if: matrix.format == 'RPM'
+        run: dnf install -y git tar gzip
+      - name: Ensure checkout prerequisites (Arch)
+        if: matrix.format == 'ARCH'
+        run: pacman -Sy --noconfirm --needed git sudo
+      - uses: actions/checkout@v4
+      - name: Set up unprivileged Arch package builder
+        if: matrix.format == 'ARCH'
+        shell: bash
+        run: |
+          useradd -m -s /bin/bash builduser
+          echo 'builduser ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builduser
+          chmod 0440 /etc/sudoers.d/builduser
+          chown -R builduser:builduser "$GITHUB_WORKSPACE"
+      - name: Full bootstrap on Debian
+        if: matrix.format == 'DEB'
+        shell: bash
+        run: |
+          set -euo pipefail
+          ./setup.sh --init BootstrapSmoke --output "$GITHUB_WORKSPACE/out/e2e smoke" --package --run --jobs 2
+          cmake "-DPACKAGE_DIR=$GITHUB_WORKSPACE/out/e2e smoke/out/packages/app-release" -DPACKAGE_FORMAT=DEB -P scripts/verify-package.cmake
+      - name: Full bootstrap on RPM family
+        if: matrix.format == 'RPM'
+        shell: bash
+        run: |
+          set -euo pipefail
+          ./setup.sh --init BootstrapSmoke --output "$GITHUB_WORKSPACE/out/e2e smoke" --package --run --jobs 2
+          cmake "-DPACKAGE_DIR=$GITHUB_WORKSPACE/out/e2e smoke/out/packages/app-release" -DPACKAGE_FORMAT=RPM -P scripts/verify-package.cmake
+          test ! -e "$GITHUB_WORKSPACE/out/e2e smoke/out/packages/app-release/should-not-exist.deb"
+      - name: Full bootstrap as unprivileged Arch user
+        if: matrix.format == 'ARCH'
+        shell: bash
+        run: |
+          set -euo pipefail
+          runuser -u builduser -- bash -c 'set -euo pipefail; cd "$1"; ./setup.sh --init BootstrapSmoke --output "$1/out/e2e smoke" --package --run --jobs 2; cmake "-DPACKAGE_DIR=$1/out/e2e smoke/out/packages/app-release" -DPACKAGE_FORMAT=ARCH -P scripts/verify-package.cmake' _ "$GITHUB_WORKSPACE"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: native-${{ matrix.system }}
+          path: out/e2e smoke/out/packages/app-release/
+          if-no-files-found: error
+
+  linux-family-unit:
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v4
+      - name: Assert Debian, Fedora, Arch and ID_LIKE classification
+        run: cmake "-DCHECK_BINARY=${{ runner.temp }}/family-fixtures" -P scripts/test-linux-family.cmake
+      - name: Reject foreign package formats even if both tools are installed
+        run: cmake "-DCHECK_BINARY=${{ runner.temp }}/package-fixtures" -P scripts/test-package-selection.cmake
+      - name: Check offline option forwarding and tool profile selection
+        run: |
+          bash scripts/test-entry.sh
+          bash scripts/test-setup-host.sh
