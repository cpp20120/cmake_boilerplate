diff --git a/lib/cmake/testing/CTestDashboard.cmake.in b/lib/cmake/testing/CTestDashboard.cmake.in
index 49aab4f..4e6ba30 100644
--- a/lib/cmake/testing/CTestDashboard.cmake.in
+++ b/lib/cmake/testing/CTestDashboard.cmake.in
@@ -48,10 +48,38 @@ if(_resource)
   list(APPEND _test_args RESOURCE_SPEC_FILE "${_resource}")
 endif()
 
+# CTest TAGs have minute precision. A second non-APPEND dashboard run in the
+# same minute can reuse the directory and accidentally submit XML from a prior
+# run (especially Coverage.xml after coverage was switched OFF).
+# Serialize this boilerplate's runs in the same build tree while working with
+# the shared Testing/TAG and its report files.
+file(MAKE_DIRECTORY "${CTEST_BINARY_DIRECTORY}/Testing")
+file(LOCK "${CTEST_BINARY_DIRECTORY}/Testing/boilerplate-dashboard.lock"
+  GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE _dashboard_lock_result)
+if(NOT _dashboard_lock_result STREQUAL "0")
+  message(FATAL_ERROR "Another dashboard run owns this build tree: ${_dashboard_lock_result}")
+endif()
 ctest_start("${_model}")
+file(STRINGS "${CTEST_BINARY_DIRECTORY}/Testing/TAG" _dashboard_tag LIMIT_COUNT 1)
+if(NOT _dashboard_tag MATCHES "^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]$")
+  message(FATAL_ERROR "Unexpected CTest TAG: '${_dashboard_tag}'")
+endif()
+set(_dashboard_tag_dir "${CTEST_BINARY_DIRECTORY}/Testing/${_dashboard_tag}")
+# ctest_start writes Testing/TAG; the tagged directory can be created lazily
+# by the first reporting step.
+file(MAKE_DIRECTORY "${_dashboard_tag_dir}")
+# Clear reports, not the TAG itself or CTest's Temporary diagnostics. On a
+# reused TAG this also clears CoverageLog-*.xml and old MemCheck reports.
+file(GLOB _stale_dashboard_xml LIST_DIRECTORIES FALSE "${_dashboard_tag_dir}/*.xml")
+if(_stale_dashboard_xml)
+  file(REMOVE ${_stale_dashboard_xml})
+endif()
+
+set(_submit_parts Start)
 set(_failed FALSE)
 ctest_configure(BUILD "${CTEST_BINARY_DIRECTORY}" SOURCE "${CTEST_SOURCE_DIRECTORY}"
   RETURN_VALUE _configure_result CAPTURE_CMAKE_ERROR _configure_error)
+list(APPEND _submit_parts Configure)
 if(NOT _configure_result EQUAL 0 OR NOT _configure_error EQUAL 0)
   set(_failed TRUE)
   message(STATUS "Dashboard Configure failed: ${_configure_result}/${_configure_error}")
@@ -60,6 +88,7 @@ else()
     PARALLEL_LEVEL "${_parallel}" RETURN_VALUE _build_result
     NUMBER_ERRORS _build_errors NUMBER_WARNINGS _build_warnings
     CAPTURE_CMAKE_ERROR _build_error)
+  list(APPEND _submit_parts Build)
   if(NOT _build_result EQUAL 0 OR NOT _build_error EQUAL 0 OR _build_errors GREATER 0)
     set(_failed TRUE)
     message(STATUS "Dashboard Build failed: ${_build_result}/${_build_error}, errors=${_build_errors}")
@@ -90,6 +119,7 @@ else()
       endif()
     endif()
     ctest_test(${_test_args})
+    list(APPEND _submit_parts Test)
     if(NOT _test_result EQUAL 0 OR NOT _test_error EQUAL 0)
       set(_failed TRUE)
       message(STATUS "Dashboard Test failed: ${_test_result}/${_test_error}")
@@ -130,6 +160,8 @@ else()
           if(NOT _coverage_body MATCHES "<LOC(Tested|UnTested)>[0-9]+</LOC(Tested|UnTested)>")
             set(_failed TRUE)
             message(STATUS "Dashboard Coverage.xml has no measured lines")
+          else()
+            list(APPEND _submit_parts Coverage)
           endif()
         endif()
       endif()
@@ -138,6 +170,7 @@ else()
       set(CTEST_MEMORYCHECK_COMMAND "@_dashboard_memcheck@")
       set(CTEST_MEMORYCHECK_TYPE Valgrind)
       ctest_memcheck(${_test_args} DEFECT_COUNT _defects)
+      list(APPEND _submit_parts MemCheck)
       if(NOT _test_result EQUAL 0 OR NOT _test_error EQUAL 0 OR _defects GREATER 0)
         set(_failed TRUE)
         message(STATUS "Dashboard MemCheck failed: ${_test_result}/${_test_error}, defects=${_defects}")
@@ -152,11 +185,13 @@ if(_submit)
   set(CTEST_SUBMIT_URL "${_url}")
   if(DEFINED ENV{BOILERPLATE_CDASH_BEARER_TOKEN} AND
       NOT "$ENV{BOILERPLATE_CDASH_BEARER_TOKEN}" STREQUAL "")
-    ctest_submit(RETRY_COUNT "${_retry_count}" RETRY_DELAY "${_retry_delay}"
+    ctest_submit(PARTS ${_submit_parts}
+      RETRY_COUNT "${_retry_count}" RETRY_DELAY "${_retry_delay}"
       HTTPHEADER "Authorization: Bearer $ENV{BOILERPLATE_CDASH_BEARER_TOKEN}"
       RETURN_VALUE _submit_result CAPTURE_CMAKE_ERROR _submit_error)
   else()
-    ctest_submit(RETRY_COUNT "${_retry_count}" RETRY_DELAY "${_retry_delay}"
+    ctest_submit(PARTS ${_submit_parts}
+      RETRY_COUNT "${_retry_count}" RETRY_DELAY "${_retry_delay}"
       RETURN_VALUE _submit_result CAPTURE_CMAKE_ERROR _submit_error)
   endif()
   if(NOT _submit_result EQUAL 0 OR NOT _submit_error EQUAL 0)
diff --git a/scripts/test-dashboard.cmake b/scripts/test-dashboard.cmake
index ce28e21..ee4b6c5 100644
--- a/scripts/test-dashboard.cmake
+++ b/scripts/test-dashboard.cmake
@@ -87,6 +87,35 @@ if(_gxx)
   if(NOT _coverage_body MATCHES "<LOCTested>[1-9][0-9]*</LOCTested>")
     message(FATAL_ERROR "Coverage.xml lacks measured coverage")
   endif()
+
+  # Coverage ON -> OFF in the same CTest TAG must not preserve old XML.
+  # The run normally stays within the same minute. In the rare event that it
+  # crosses a minute boundary, repeat the OFF run with a sentinel in the new
+  # current TAG to deterministically exercise directory cleanup.
+  file(STRINGS "${_coverage}/Testing/TAG" _covered_tag LIMIT_COUNT 1)
+  run("${CMAKE_COMMAND}" -S "${_fixture}" -B "${_coverage}"
+    -DBOILERPLATE_DASHBOARD_COVERAGE=OFF)
+  run("${CMAKE_COMMAND}" --build "${_coverage}" --target boilerplate_dashboard)
+  file(STRINGS "${_coverage}/Testing/TAG" _off_tag LIMIT_COUNT 1)
+  if(NOT _off_tag STREQUAL _covered_tag)
+    file(WRITE "${_coverage}/Testing/${_off_tag}/Coverage.xml" "stale coverage must be removed")
+    run("${CMAKE_COMMAND}" --build "${_coverage}" --target boilerplate_dashboard)
+    file(STRINGS "${_coverage}/Testing/TAG" _off_tag LIMIT_COUNT 1)
+  endif()
+  if(EXISTS "${_coverage}/Testing/${_off_tag}/Coverage.xml")
+    message(FATAL_ERROR "Old Coverage.xml survived a dashboard run with coverage OFF")
+  endif()
+  # Also ensure disabled/unexecuted stages do not leave other report XML behind.
+  file(WRITE "${_coverage}/Testing/${_off_tag}/Update.xml" "stale update")
+  file(WRITE "${_coverage}/Testing/${_off_tag}/DynamicAnalysis.xml" "stale memcheck")
+  file(WRITE "${_coverage}/Testing/${_off_tag}/CoverageLog-0.xml" "stale coverage details")
+  run("${CMAKE_COMMAND}" --build "${_coverage}" --target boilerplate_dashboard)
+  file(STRINGS "${_coverage}/Testing/TAG" _clean_tag LIMIT_COUNT 1)
+  foreach(_part IN ITEMS Update DynamicAnalysis CoverageLog-0 Coverage)
+    if(EXISTS "${_coverage}/Testing/${_clean_tag}/${_part}.xml")
+      message(FATAL_ERROR "Stale ${_part}.xml survived a dashboard run")
+    endif()
+  endforeach()
 endif()
 set(_multi "${CHECK_BINARY}/multi")
 run("${CMAKE_COMMAND}" -S "${_fixture}" -B "${_multi}" -G "Ninja Multi-Config"
