cmake_minimum_required(VERSION 3.26)
if(NOT DEFINED ACTION)
  set(ACTION check)
endif()
if(NOT ACTION MATCHES "^(check|update)$")
  message(FATAL_ERROR "ACTION must be check or update")
endif()
if(NOT DEFINED SOURCE_DIR)
  set(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/..")
endif()
file(REAL_PATH "${SOURCE_DIR}" SOURCE_DIR)
find_program(_git git REQUIRED)
execute_process(COMMAND "${_git}" -C "${SOURCE_DIR}" rev-parse --show-toplevel
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _top ERROR_VARIABLE _error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _rc STREQUAL "0")
  message(FATAL_ERROR "Manifest maintenance requires a Git checkout: ${_error}")
endif()
file(REAL_PATH "${_top}" _top)
if(NOT _top STREQUAL SOURCE_DIR)
  message(FATAL_ERROR "SOURCE_DIR must be the Git repository root")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TemplatePolicy.cmake")
execute_process(COMMAND "${_git}" -C "${SOURCE_DIR}" -c core.quotepath=false ls-files
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _tracked ERROR_VARIABLE _error)
if(NOT _rc STREQUAL "0")
  message(FATAL_ERROR "git ls-files failed: ${_error}")
endif()
if(_tracked MATCHES ";")
  message(FATAL_ERROR "Template paths containing semicolons are not supported")
endif()
string(REPLACE "\r\n" "\n" _tracked "${_tracked}")
string(REPLACE "\n" ";" _tracked "${_tracked}")
set(_expected)
set(_unknown)
foreach(_file IN LISTS _tracked)
  if(_file STREQUAL "")
    continue()
  endif()
  if(NOT _file MATCHES "^[A-Za-z0-9_./ -]+$")
    message(FATAL_ERROR "Unsupported template path: ${_file}")
  endif()
  set(_excluded FALSE)
  foreach(_pattern IN LISTS TEMPLATE_EXCLUDE_PATTERNS)
    if(_file MATCHES "${_pattern}")
      set(_excluded TRUE)
      break()
    endif()
  endforeach()
  if(_excluded)
    continue()
  endif()
  set(_included FALSE)
  foreach(_pattern IN LISTS TEMPLATE_INCLUDE_PATTERNS)
    if(_file MATCHES "${_pattern}")
      set(_included TRUE)
      break()
    endif()
  endforeach()
  if(_included)
    if(NOT EXISTS "${SOURCE_DIR}/${_file}" OR IS_SYMLINK "${SOURCE_DIR}/${_file}" OR IS_DIRECTORY "${SOURCE_DIR}/${_file}")
      message(FATAL_ERROR "Tracked template input is missing or not a regular file: ${_file}")
    endif()
    list(APPEND _expected "${_file}")
  else()
    list(APPEND _unknown "${_file}")
  endif()
endforeach()
if(_unknown)
  message(FATAL_ERROR "Unclassified tracked files; update TemplatePolicy.cmake:\n  ${_unknown}")
endif()
list(REMOVE_DUPLICATES _expected)
list(SORT _expected)
set(_manifest "${SOURCE_DIR}/scripts/template-files.txt")
if(ACTION STREQUAL update)
  list(JOIN _expected "\n" _body)
  file(WRITE "${_manifest}" "# Generated by scripts/TemplateManifest.cmake; policy: scripts/TemplatePolicy.cmake\n${_body}\n")
  message(STATUS "Updated ${_manifest}")
else()
  file(STRINGS "${_manifest}" _actual)
  list(FILTER _actual EXCLUDE REGEX "^(#|$)")
  set(_missing "${_expected}")
  set(_extra "${_actual}")
  if(_actual)
    list(REMOVE_ITEM _missing ${_actual})
  endif()
  if(_expected)
    list(REMOVE_ITEM _extra ${_expected})
  endif()
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Template manifest is stale.\nMissing: ${_missing}\nExtra/untracked: ${_extra}\nAlso check ordering/duplicates. Stage new source files, then run cmake -DACTION=update -P scripts/TemplateManifest.cmake")
  endif()
  message(STATUS "Template manifest matches tracked files and policy")
endif()
