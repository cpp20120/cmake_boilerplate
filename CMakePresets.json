{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "BUILD_TESTING": "ON",
        "BOILERPLATE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "base-windows",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "ninja"
      }
    },
    {
      "name": "base-macos",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_MAKE_PROGRAM": "ninja"
      }
    },
    {
      "name": "release",
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "windows-release",
      "inherits": [
        "release",
        "base-windows"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "macos-release",
      "inherits": [
        "release",
        "base-macos"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    },
    {
      "name": "debug",
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "windows-debug",
      "inherits": [
        "debug",
        "base-windows"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "macos-debug",
      "inherits": [
        "debug",
        "base-macos"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    },
    {
      "name": "debug-sanitize-address",
      "inherits": [
        "debug"
      ],
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON",
        "SANITIZER": "address"
      }
    },
    {
      "name": "debug-sanitize-thread",
      "inherits": [
        "debug"
      ],
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON",
        "SANITIZER": "thread"
      }
    },
    {
      "name": "debug-sanitize-undefined",
      "inherits": [
        "debug"
      ],
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON",
        "SANITIZER": "undefined"
      }
    },
    {
      "name": "debug-sanitize-leak",
      "inherits": [
        "debug"
      ],
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON",
        "SANITIZER": "leak"
      }
    },
    {
      "name": "vcpkg-release",
      "inherits": [
        "release"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": "on",
        "BOILERPLATE_DEPENDENCY_PROVIDER": "vcpkg"
      }
    },
    {
      "name": "vcpkg-windows-release",
      "inherits": [
        "windows-release"
      ],
      "cacheVariables": {
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": "on",
        "BOILERPLATE_DEPENDENCY_PROVIDER": "vcpkg"
      }
    },
    {
      "name": "vcpkg-macos-release",
      "inherits": [
        "macos-release"
      ],
      "cacheVariables": {
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": "on",
        "BOILERPLATE_DEPENDENCY_PROVIDER": "vcpkg"
      }
    },
    {
      "name": "vcpkg-debug",
      "inherits": [
        "debug"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": "on",
        "BOILERPLATE_DEPENDENCY_PROVIDER": "vcpkg"
      }
    },
    {
      "name": "vcpkg-windows-debug",
      "inherits": [
        "windows-debug"
      ],
      "cacheVariables": {
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": "on",
        "BOILERPLATE_DEPENDENCY_PROVIDER": "vcpkg"
      }
    },
    {
      "name": "vcpkg-macos-debug",
      "inherits": [
        "macos-debug"
      ],
      "cacheVariables": {
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": "on",
        "BOILERPLATE_DEPENDENCY_PROVIDER": "vcpkg"
      }
    },
    {
      "name": "vcpkg-debug-sanitize-address",
      "inherits": [
        "vcpkg-debug"
      ],
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON",
        "SANITIZER": "address",
        "BOILERPLATE_DEPENDENCY_PROVIDER": "vcpkg",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": "on"
      }
    },
    {
      "name": "vcpkg-debug-sanitize-thread",
      "inherits": [
        "vcpkg-debug"
      ],
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON",
        "SANITIZER": "thread",
        "BOILERPLATE_DEPENDENCY_PROVIDER": "vcpkg",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": "on"
      }
    },
    {
      "name": "fuzz-base",
      "hidden": true,
      "inherits": "debug",
      "cacheVariables": {
        "ENABLE_FUZZING": "ON",
        "ENABLE_SANITIZERS": "ON",
        "SANITIZER": "address",
        "FUZZ_RUNTIME": "60"
      }
    },
    {
      "name": "fuzz-linux",
      "inherits": [
        "fuzz-base"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "BOILERPLATE_FUZZ_BACKEND": "libfuzzer"
      }
    },
    {
      "name": "fuzz-windows",
      "inherits": [
        "fuzz-base",
        "base-windows"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl",
        "BOILERPLATE_FUZZ_BACKEND": "libfuzzer"
      }
    },
    {
      "name": "fuzz-macos",
      "inherits": [
        "fuzz-base",
        "base-macos"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "BOILERPLATE_FUZZ_BACKEND": "libfuzzer"
      }
    },
    {
      "name": "fuzz-vcpkg",
      "inherits": [
        "fuzz-base"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "BOILERPLATE_FUZZ_BACKEND": "libfuzzer",
        "BOILERPLATE_DEPENDENCY_PROVIDER": "vcpkg",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": "on"
      }
    },
    {
      "name": "app-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BOILERPLATE_LIBRARIES_ONLY": "OFF",
        "BOILERPLATE_BUILD_TESTS": "ON",
        "BOILERPLATE_BUILD_SHARED": "ON",
        "BOILERPLATE_BUILD_STATIC": "OFF"
      }
    },
    {
      "name": "app-vcpkg-provider",
      "hidden": true,
      "cacheVariables": {
        "BOILERPLATE_DEPENDENCY_PROVIDER": "vcpkg",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": "on"
      }
    },
    {
      "name": "app-vcpkg-all",
      "inherits": [
        "app-release",
        "app-vcpkg-provider"
      ],
      "cacheVariables": {
        "BOILERPLATE_PROJECT_CAPABILITIES": "full",
        "BOILERPLATE_BUILD_EXAMPLES": "ON",
        "BOILERPLATE_BUILD_GOOGLE_TESTS": "ON",
        "BOILERPLATE_BUILD_BENCHMARKS": "ON",
        "BOILERPLATE_BUILD_GOOGLE_BENCHMARKS": "ON",
        "BOILERPLATE_BUILD_PROPERTY_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;pbt;benchmarks"
      }
    },
    {
      "name": "app-debug",
      "inherits": "app-base",
      "cacheVariables": {
        "BOILERPLATE_PROFILE": "debug"
      }
    },
    {
      "name": "app-qt-debug",
      "inherits": "app-debug",
      "description": "Debug build with the Qt 6 Widgets example",
      "cacheVariables": {
        "BOILERPLATE_BUILD_QT_EXAMPLE": "ON"
      }
    },
    {
      "name": "app-cuda-debug",
      "inherits": "app-debug",
      "description": "Debug build with the CUDA project capability; apply CUDA policies per target",
      "cacheVariables": {
        "BOILERPLATE_PROJECT_CAPABILITIES": "developer;cuda",
        "BOILERPLATE_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "app-release",
      "inherits": "app-base",
      "cacheVariables": {
        "BOILERPLATE_PROFILE": "release"
      }
    },
    {
      "name": "app-qt-release",
      "inherits": "app-release",
      "description": "Release build with the Qt 6 Widgets example",
      "cacheVariables": {
        "BOILERPLATE_BUILD_QT_EXAMPLE": "ON"
      }
    },
    {
      "name": "app-cuda-release",
      "inherits": "app-release",
