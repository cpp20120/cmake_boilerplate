    {
      "name": "test-fuzz",
      "configurePreset": "fuzz-linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "filter": {
        "include": {
          "name": "^fuzz_target$"
        }
      }
    },
    {
      "name": "test-fuzz-short",
      "configurePreset": "fuzz-linux",
      "output": {
