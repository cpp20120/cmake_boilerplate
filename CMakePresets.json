      }
    },
    {
      "name": "app-tsan",
      "inherits": "app-debug",
      "cacheVariables": {
        "BOILERPLATE_SANITIZER": "thread"
      }
    },
    {
      "name": "app-examples",
      "inherits": "app-debug",
      "cacheVariables": {
        "BOILERPLATE_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "app-google-tests",
      "inherits": "app-debug",
      "cacheVariables": {
        "BOILERPLATE_BUILD_GOOGLE_TESTS": "ON"
      }
    },
    {
      "name": "app-fuzz",
      "inherits": "app-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "BOILERPLATE_BUILD_FUZZERS": "ON",
        "BOILERPLATE_FUZZ_BACKEND": "libfuzzer"
      }
    },
    {
      "name": "app-bench-both",
      "inherits": "app-release",
      "cacheVariables": {
        "BOILERPLATE_BUILD_BENCHMARKS": "ON",
        "BOILERPLATE_BUILD_GOOGLE_BENCHMARKS": "ON"
      }
    },
    {
      "name": "app-minimal",
      "inherits": "app-release",
      "cacheVariables": {
        "BOILERPLATE_PROJECT_CAPABILITIES": "project-minimal",
        "BOILERPLATE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "app-ci",
      "inherits": "app-debug",
      "cacheVariables": {
        "BOILERPLATE_PROJECT_CAPABILITIES": "ci",
        "BOILERPLATE_REQUIRE_PROJECT_TOOLS": "ON"
      }
    },
    {
      "name": "app-distribution",
      "inherits": "app-release",
      "cacheVariables": {
        "BOILERPLATE_PROJECT_CAPABILITIES": "distribution;testing"
      }
    },
    {
      "name": "app-full",
      "inherits": "app-release",
      "cacheVariables": {
        "BOILERPLATE_PROJECT_CAPABILITIES": "full"
      }
    },
    {
      "name": "app-property-tests",
      "inherits": "app-debug",
      "cacheVariables": {
        "BOILERPLATE_BUILD_PROPERTY_TESTS": "ON",
        "BOILERPLATE_PROJECT_CAPABILITIES": "developer;property-testing"
      }
    },
    {
      "name": "app-fuzz-aflpp",
      "inherits": "app-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "afl-clang-fast++",
        "BOILERPLATE_FUZZ_BACKEND": "aflpp",
        "BOILERPLATE_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "app-fuzz-honggfuzz",
      "inherits": "app-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "hfuzz-clang++",
        "BOILERPLATE_FUZZ_BACKEND": "honggfuzz",
        "BOILERPLATE_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "app-fuzztest-unit",
      "inherits": "app-debug",
      "cacheVariables": {
        "BOILERPLATE_BUILD_FUZZTESTS": "ON",
        "BOILERPLATE_FUZZTEST_MODE": "unit"
      }
    },
    {
      "name": "app-fuzztest-fuzzing",
      "inherits": "app-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "BOILERPLATE_BUILD_FUZZTESTS": "ON",
        "BOILERPLATE_FUZZTEST_MODE": "fuzzing"
      }
    }
